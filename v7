// COMMAND STATS
// ══════════════════════════════════════════════════
function renderCommandStats() {
  var p = P();
  var taskProg   = p.completedTasks.length / CAMPAIGN_STEPS.length * 100;
  var splitsSum  = p.splits.reduce(function(s,x){ return s + x.percentage; }, 0);
  var readiness  = (taskProg + (splitsSum === 100 ? 100 : 0)) / 2;
  var r = 23, cv = r*2*Math.PI, o = cv - (readiness/100)*cv;
  document.getElementById('readinessRing').innerHTML =
    '<circle stroke="var(--border)" fill="none" stroke-width="5" r="' + r + '" cx="29" cy="29" style="transform:rotate(-90deg);transform-origin:center"/>' +
    '<circle stroke="var(--violet)" fill="none" stroke-width="5" stroke-linecap="round" r="' + r + '" cx="29" cy="29" stroke-dasharray="' + cv + ' ' + cv + '" stroke-dashoffset="' + o + '" style="transform:rotate(-90deg);transform-origin:center;transition:stroke-dashoffset .5s"/>' +
    '<text x="29" y="34" text-anchor="middle" fill="var(--text)" font-size="11" font-weight="800" font-family="DM Mono">' + Math.round(readiness) + '%</text>';
  document.getElementById('readinessLabel').textContent = readiness >= 80 ? 'Ready' : readiness >= 50 ? 'Progress' : 'Setup';
  document.getElementById('tasksCompleted').textContent = p.completedTasks.length;
  document.getElementById('totalTasksCount').textContent = CAMPAIGN_STEPS.length;
  document.getElementById('tasksProgress').style.width = taskProg + '%';
  document.getElementById('splitsTotal').textContent = splitsSum + '%';
  document.getElementById('splitsTotal').style.color = splitsSum === 100 ? 'var(--emerald)' : 'var(--rose)';
  document.getElementById('splitsStatus').textContent = splitsSum === 100 ? 'Balanced' : splitsSum + '% — fix splits';
  document.getElementById('splitsStatus').style.color = splitsSum === 100 ? 'var(--text3)' : 'var(--rose)';
  var today = new Date(); today.setHours(0,0,0,0);
  var oc = CAMPAIGN_STEPS.filter(function(s,i){ return !p.completedTasks.includes(i) && getTaskDate(s.num) < today; }).length;
  document.getElementById('overdueAlert').style.display = oc ? 'flex' : 'none';
  if (oc) document.getElementById('overdueCount').textContent = oc;
  var spent = p.budget.items.reduce(function(s,i){ return s + i.spent; }, 0);
  document.getElementById('budgetSpent').textContent = spent;
  document.getElementById('budgetTotalHeader').textContent = p.budget.total;
}

