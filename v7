}

// ══════════════════════════════════════════════════
// TASK TOGGLE
// ══════════════════════════════════════════════════
function toggleTask(i) {
  var ct = P().completedTasks;
  if (ct.includes(i)) { P().completedTasks = ct.filter(function(x){ return x !== i; }); }
  else { ct.push(i); }
  saveApp(); renderAll();
}

