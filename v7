function cycleIndexStatus(sectionId, itemId) {
  var p = P();
  var key = sectionId + ':' + itemId;
  var cur = p.indexStatuses[key] || 'ns';
  var next = cur === 'ns' ? 'ip' : cur === 'ip' ? 'done' : 'ns';
  p.indexStatuses[key] = next;
  saveApp();
  renderStrategyIndex();
}
function getIndexStatus(sectionId, itemId) {
  return (P().indexStatuses || {})[(sectionId + ':' + itemId)] || 'ns';
}
function renderStrategyIndex() {
  var html = '';
  STRATEGY_INDEX.forEach(function(section) {
    var total = section.items.length;
    var done  = section.items.filter(function(it){ return getIndexStatus(section.id, it.id) === 'done'; }).length;
    var ip    = section.items.filter(function(it){ return getIndexStatus(section.id, it.id) === 'ip';   }).length;
    var pct   = total ? Math.round(done/total*100) : 0;

    html += '<div class="idx-section">' +
      '<div class="idx-section-header">' +
        '<span class="idx-section-icon">' + section.icon + '</span>' +
        '<span class="idx-section-title">' + section.title + '</span>' +
        '<span class="idx-section-prog">' + done + '/' + total + ' complete</span>' +
        (ip > 0 ? '<span style="font-size:11px;color:#fcd34d;font-family:var(--mono);margin-left:6px">' + ip + ' in progress</span>' : '') +
      '</div>' +
      '<div class="idx-section-progress-bar"><div class="idx-section-progress-fill" style="width:' + pct + '%;background:' + section.color + '"></div></div>' +
      '<table class="idx-table"><thead><tr><th style="width:40%">Template / Guide</th><th>Description</th><th style="width:130px;text-align:right">Status</th></tr></thead><tbody>';

    section.items.forEach(function(item) {
      var status = getIndexStatus(section.id, item.id);
      var btnCls = status === 'done' ? 'idx-status-btn idx-status-done' : status === 'ip' ? 'idx-status-btn idx-status-ip' : 'idx-status-btn idx-status-ns';
      var btnTxt = status === 'done' ? '✓ Complete' : status === 'ip' ? '● In Progress' : '○ Not Started';
      html += '<tr>' +
        '<td><div class="idx-item-name"><span class="idx-item-icon">' + item.icon + '</span>' + escHtml(item.name) + '</div></td>' +
        '<td style="font-size:12px;color:var(--text2);line-height:1.55">' + escHtml(item.desc) + '</td>' +
        '<td style="text-align:right"><button class="' + btnCls + '" onclick="cycleIndexStatus(\'' + section.id + '\',\'' + item.id + '\')">' + btnTxt + '</button></td>' +
        '</tr>';
    });

    html += '</tbody></table></div>';
  });

  // Summary bar
  var totalAll = STRATEGY_INDEX.reduce(function(s,sec){ return s + sec.items.length; }, 0);
  var doneAll  = STRATEGY_INDEX.reduce(function(s,sec){
    return s + sec.items.filter(function(it){ return getIndexStatus(sec.id, it.id) === 'done'; }).length;
  }, 0);
  var ipAll = STRATEGY_INDEX.reduce(function(s,sec){
    return s + sec.items.filter(function(it){ return getIndexStatus(sec.id, it.id) === 'ip'; }).length;
  }, 0);
  var summaryHtml = '<div class="card card-p" style="display:flex;align-items:center;gap:20px;flex-wrap:wrap">' +
    '<div style="font-weight:700;font-size:13px">Overall Progress</div>' +
    '<div style="display:flex;gap:16px">' +
