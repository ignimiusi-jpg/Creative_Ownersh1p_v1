function switchTab(id) {
  document.querySelectorAll('.tab-content').forEach(function(t){ t.classList.remove('active'); });
  document.querySelectorAll('.nav-item').forEach(function(b){ b.classList.remove('active'); });
  document.getElementById(id).classList.add('active');
  document.querySelectorAll('.nav-item').forEach(function(b){
    if (b.getAttribute('onclick') === "switchTab('" + id + "')") b.classList.add('active');
  });
  if (id==='calendar') renderCalendar();
  if (id==='timeline') renderTimeline();
  if (id==='campaign') renderCampaignSteps();
  if (id==='index')    renderStrategyIndex();
}
function switchInnerTab(id, btn) {
  document.querySelectorAll('.inner-tab-content').forEach(function(t){ t.classList.remove('active'); });
  document.querySelectorAll('.inner-tab').forEach(function(b){ b.classList.remove('active'); });
  document.getElementById(id).classList.add('active');
  btn.classList.add('active');
}
function exportData() {
  var b = new Blob([JSON.stringify(app,null,2)],{type:'application/json'});
  var a = document.createElement('a'); a.href = URL.createObjectURL(b);
  a.download = 'launch-command-' + P().name.replace(/\s+/g,'-') + '.json'; a.click();
}

