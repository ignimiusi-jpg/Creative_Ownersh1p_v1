function engColor(eng, platform) {
  var hi = platform==='instagram' ? 4 : 5, mid = platform==='instagram' ? 1.5 : 2;
  return eng >= hi ? '#6ee7b7' : eng >= mid ? '#fcd34d' : '#fca5a5';
}
function engTier(eng, platform) {
  if (platform === 'tiktok') {
    if (eng>=8)   return {label:'Viral',    color:'#fcd34d', desc:'Exceptional engagement. Your content is resonating hard. Time to scale with ads.'};
    if (eng>=4)   return {label:'Solid',    color:'#6ee7b7', desc:'Good engagement. The algorithm favors you. Stay consistent.'};
    if (eng>=1.5) return {label:'Growing',  color:'#93c5fd', desc:'Average engagement. Experiment with formats and posting times.'};
    return         {label:'Low',           color:'#fca5a5', desc:'Needs attention. Analyze which content generated the most interaction.'};
  } else {
    if (eng>=5)   return {label:'Exceptional', color:'#fcd34d', desc:'Very high engagement. Your audience is highly committed.'};
    if (eng>=2.5) return {label:'Good',         color:'#6ee7b7', desc:'Above average. Keep doing what works.'};
    if (eng>=1)   return {label:'Average',      color:'#93c5fd', desc:'Within normal range. Try posting more Reels.'};
    return         {label:'Low',               color:'#fca5a5', desc:'Below average. Consider posting more consistently.'};
  }
}
function renderSocialAudit() {
  var platform = P().social ? P().social.platform : 'tiktok';
  var pd = getSPD();
  if (!pd) return;
  var audits = pd.audits || [];
  var latest = audits.length ? audits[audits.length-1] : null;
  var statsWrap   = document.getElementById('socialCurrentStats');
  var healthPanel = document.getElementById('socialHealthPanel');
  var statsGrid   = document.getElementById('socialStatsGrid');
  if (latest) {
    statsWrap.classList.remove('hidden');
    healthPanel.style.display = 'grid';
    var prev = audits.length > 1 ? audits[audits.length-2] : null;
    var fDelta = prev ? latest.followers - prev.followers : null;
    var eDelta = prev ? +(latest.engRate - prev.engRate).toFixed(2) : null;
    function deltaHTML(val, suffix) {
      suffix = suffix || '';
      return val === null ? '' : '<div style="font-size:11px;color:' + (val>=0?'#6ee7b7':'#fca5a5') + ';margin-top:3px">' + (val>=0?'↑':'↓') + ' ' + Math.abs(val).toLocaleString() + suffix + ' vs prev</div>';
    }
    if (platform === 'tiktok') {
      statsGrid.innerHTML =
        '<div class="audit-stat tiktok-grad"><div class="audit-stat-label">Followers</div><div class="audit-stat-val">' + fmtN(latest.followers) + '</div>' + deltaHTML(fDelta) + '</div>' +
        '<div class="audit-stat tiktok-grad"><div class="audit-stat-label">Avg Views</div><div class="audit-stat-val">' + fmtN(latest.avgViews) + '</div><div class="audit-stat-sub">per video</div></div>' +
        '<div class="audit-stat tiktok-grad"><div class="audit-stat-label">Avg Likes</div><div class="audit-stat-val">' + fmtN(latest.avgLikes) + '</div></div>' +
        '<div class="audit-stat tiktok-grad"><div class="audit-stat-label">Engagement</div><div class="audit-stat-val" style="color:' + engColor(latest.engRate) + '">' + latest.engRate + '%</div>' + deltaHTML(eDelta,'%') + '</div>' +
        '<div class="audit-stat tiktok-grad"><div class="audit-stat-label">Avg Comments</div><div class="audit-stat-val">' + fmtN(latest.avgComments) + '</div></div>' +
        '<div class="audit-stat tiktok-grad"><div class="audit-stat-label">Avg Shares</div><div class="audit-stat-val">' + fmtN(latest.avgShares) + '</div></div>' +
        '<div class="audit-stat tiktok-grad"><div class="audit-stat-label">Total Likes</div><div class="audit-stat-val">' + fmtN(latest.totalLikes) + '</div></div>' +
        '<div class="audit-stat tiktok-grad"><div class="audit-stat-label">Captured</div><div class="audit-stat-val" style="font-size:13px">' + latest.date + '</div><div class="audit-stat-sub">' + audits.length + ' audit' + (audits.length!==1?'s':'') + '</div></div>';
    } else {
      statsGrid.innerHTML =
        '<div class="audit-stat ig-grad"><div class="audit-stat-label">Followers</div><div class="audit-stat-val">' + fmtN(latest.followers) + '</div>' + deltaHTML(fDelta) + '</div>' +
        '<div class="audit-stat ig-grad"><div class="audit-stat-label">Avg Likes</div><div class="audit-stat-val">' + fmtN(latest.avgLikes) + '</div><div class="audit-stat-sub">per post</div></div>' +
        '<div class="audit-stat ig-grad"><div class="audit-stat-label">Avg Reach</div><div class="audit-stat-val">' + fmtN(latest.avgReach) + '</div></div>' +
        '<div class="audit-stat ig-grad"><div class="audit-stat-label">Engagement</div><div class="audit-stat-val" style="color:' + engColor(latest.engRate) + '">' + latest.engRate + '%</div>' + deltaHTML(eDelta,'%') + '</div>' +
        '<div class="audit-stat ig-grad"><div class="audit-stat-label">Avg Comments</div><div class="audit-stat-val">' + fmtN(latest.avgComments) + '</div></div>' +
        '<div class="audit-stat ig-grad"><div class="audit-stat-label">Avg Saves</div><div class="audit-stat-val">' + fmtN(latest.avgSaves) + '</div></div>' +
        '<div class="audit-stat ig-grad"><div class="audit-stat-label">Total Posts</div><div class="audit-stat-val">' + fmtN(latest.posts) + '</div></div>' +
        '<div class="audit-stat ig-grad"><div class="audit-stat-label">Captured</div><div class="audit-stat-val" style="font-size:13px">' + latest.date + '</div><div class="audit-stat-sub">' + audits.length + ' audit' + (audits.length!==1?'s':'') + '</div></div>';
    }
    var eng = latest.engRate, maxEng = platform==='tiktok' ? 15 : 8;
    var pct = Math.min(100, eng/maxEng*100), circ = 188.5, offset = circ-(pct/100)*circ;
    var arc = document.getElementById('engScoreArc');
    arc.style.strokeDashoffset = offset; arc.style.stroke = engColor(eng, platform);
    document.getElementById('engScoreText').textContent = eng + '%';
    document.getElementById('engScoreText').style.fill = engColor(eng, platform);
    var tier = engTier(eng, platform);
    document.getElementById('engScoreLabel').textContent = tier.label;
    document.getElementById('engScoreLabel').style.color = tier.color;
    document.getElementById('engScoreDesc').textContent  = tier.desc;
    var bmarks = platform==='tiktok' ? [
      {tier:'Micro (<10K)',  eng:'5–15%', followers:'<10,000'},
      {tier:'Mid (10K–100K)',eng:'3–8%',  followers:'10–100K'},
      {tier:'Macro (100K+)', eng:'1–5%',  followers:'100K+'}
    ] : [
      {tier:'Micro (<10K)',  eng:'4–8%',  followers:'<10,000'},
      {tier:'Mid (10K–100K)',eng:'2–5%',  followers:'10–100K'},
      {tier:'Macro (100K+)', eng:'1–3%',  followers:'100K+'}
    ];
    var yourTier = latest.followers < 10000 ? 0 : latest.followers < 100000 ? 1 : 2;
    document.getElementById('benchmarkList').innerHTML = bmarks.map(function(b,i){
      return '<div class="benchmark-row"><div><div style="font-size:12px;font-weight:' + (i===yourTier?'700':'500') + ';color:' + (i===yourTier?'var(--text)':'var(--text3)') + '">' + b.tier + (i===yourTier?' ← you':'') + '</div><div style="font-size:10px;color:var(--text3)">' + b.followers + '</div></div><div style="text-align:right"><div style="font-size:12px;font-family:var(--mono);color:' + (i===yourTier?engColor(eng,platform):'var(--text3)') + '">Eng: ' + b.eng + '</div>' + (i===yourTier ? '<div style="font-size:10px;color:' + engColor(eng,platform) + '">Yours: ' + eng + '%</div>' : '') + '</div></div>';
    }).join('');
  } else {
    statsWrap.classList.add('hidden');
    healthPanel.style.display = 'none';
  }
  var histEmpty  = document.getElementById('socialHistoryEmpty');
  var histTable  = document.getElementById('socialHistoryTable');
  document.getElementById('socialAuditCount').textContent = audits.length + ' entr' + (audits.length!==1?'ies':'y');
  if (!audits.length) { histEmpty.style.display=''; histTable.classList.add('hidden'); document.getElementById('socialChartCard').classList.add('hidden'); return; }
  histEmpty.style.display = 'none'; histTable.classList.remove('hidden');
  var cols = platform==='tiktok' ? ['Date','Followers','Avg Views','Avg Likes','Engagement','Notes',''] : ['Date','Followers','Avg Likes','Avg Reach','Engagement','Notes',''];
  var tHTML = '<table class="audit-history-table"><thead><tr>' + cols.map(function(c){ return '<th>'+c+'</th>'; }).join('') + '</tr></thead><tbody>';
  var rev = audits.slice().reverse();
  rev.forEach(function(a, ri) {
    var realIdx = audits.length-1-ri;
    var engCls = a.engRate >= (platform==='tiktok'?5:4) ? 'eng-great' : a.engRate >= (platform==='tiktok'?2:1.5) ? 'eng-good' : 'eng-low';
    var row = platform==='tiktok'
      ? '<td style="font-family:var(--mono);font-size:11px;color:var(--text3)">' + a.date + '</td><td style="font-weight:700">' + fmtN(a.followers) + '</td><td>' + fmtN(a.avgViews) + '</td><td>' + fmtN(a.avgLikes) + '</td>'
      : '<td style="font-family:var(--mono);font-size:11px;color:var(--text3)">' + a.date + '</td><td style="font-weight:700">' + fmtN(a.followers) + '</td><td>' + fmtN(a.avgLikes) + '</td><td>' + fmtN(a.avgReach) + '</td>';
    tHTML += '<tr>' + row + '<td><span class="eng-chip ' + engCls + '">' + a.engRate + '%</span></td><td style="color:var(--text3);font-size:11px;max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">' + escHtml(a.notes||'—') + '</td><td><button onclick="deleteAudit(' + realIdx + ')" style="background:none;border:none;cursor:pointer;color:var(--text3);font-size:12px" onmouseover="this.style.color=\'#fca5a5\'" onmouseout="this.style.color=\'var(--text3)\'">✕</button></td></tr>';
  });
  tHTML += '</tbody></table>';
  histTable.innerHTML = tHTML;
  if (audits.length >= 2) { document.getElementById('socialChartCard').classList.remove('hidden'); drawGrowthChart(audits); }
  else document.getElementById('socialChartCard').classList.add('hidden');
}
function drawGrowthChart(audits) {
  var canvas = document.getElementById('growthChart'); if (!canvas) return;
  var ctx = canvas.getContext('2d');
  var W = canvas.offsetWidth || 600; canvas.width = W; canvas.height = 130;
  ctx.clearRect(0,0,W,130);
  var followers = audits.map(function(a){ return a.followers; });
  var dates     = audits.map(function(a){ return a.date.slice(5); });
  var minF = Math.min.apply(null,followers), maxF = Math.max.apply(null,followers), range = maxF-minF||1;
  var pad = {t:14,b:26,l:10,r:10}, cW = W-pad.l-pad.r, cH = 130-pad.t-pad.b;
  var step = cW/(followers.length-1);
  var pts = followers.map(function(f,i){ return {x:pad.l+i*step, y:pad.t+cH-((f-minF)/range)*cH}; });
  var grad = ctx.createLinearGradient(0,pad.t,0,pad.t+cH);
  grad.addColorStop(0,'rgba(109,40,217,.35)'); grad.addColorStop(1,'rgba(109,40,217,.02)');
  ctx.beginPath(); ctx.moveTo(pts[0].x,pts[0].y);
  pts.slice(1).forEach(function(p){ ctx.lineTo(p.x,p.y); });
  ctx.lineTo(pts[pts.length-1].x,pad.t+cH); ctx.lineTo(pts[0].x,pad.t+cH);
  ctx.closePath(); ctx.fillStyle=grad; ctx.fill();
  ctx.beginPath(); ctx.moveTo(pts[0].x,pts[0].y);
  pts.slice(1).forEach(function(p){ ctx.lineTo(p.x,p.y); });
  ctx.strokeStyle='#7c3aed'; ctx.lineWidth=2.5; ctx.lineJoin='round'; ctx.stroke();
  ctx.font='10px DM Mono,monospace'; ctx.textAlign='center';
  pts.forEach(function(p,i){
    ctx.beginPath(); ctx.arc(p.x,p.y,4,0,Math.PI*2);
    ctx.fillStyle = i===pts.length-1?'#a78bfa':'#7c3aed'; ctx.fill();
    ctx.fillStyle='rgba(136,136,168,.7)'; ctx.fillText(dates[i],p.x,128);
    if (i===pts.length-1){ ctx.fillStyle='#a78bfa'; ctx.fillText(fmtN(followers[i]),p.x,p.y-10); }
  });
}

