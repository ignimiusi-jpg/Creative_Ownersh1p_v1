async function sendChat() {
  var input = document.getElementById('chatInput');
  var msg = input.value.trim(); if (!msg) return;
  input.value = '';
  var ai = P().ai;
  ai.genre     = document.getElementById('aiGenre').value;
  ai.mood      = document.getElementById('aiMood').value;
  ai.audience  = document.getElementById('aiAudience').value;
  ai.platforms = document.getElementById('aiPlatforms').value;
  saveApp(); addChat('user', msg);
  if (!app.globalAI.apiKey) { addChat('assistant', 'Connect your Anthropic API key above to use the assistant.'); return; }
  var lid = 'l' + Date.now(); addChat('assistant', 'Generating ideas…', lid, true);
  var sys = 'You are an expert in music marketing, A&R, and release strategy for independent artists.\nRelease: "' + P().name + '" | Genre: ' + (ai.genre||'N/A') + ' | Mood: ' + (ai.mood||'N/A') + '\nAudience: ' + (ai.audience||'N/A') + ' | Platforms: ' + (ai.platforms||'N/A') + '\nMonthly Listeners: ' + fmt(P().spotify.monthlyListeners) + ' | Release Date: ' + P().releaseDate + '\nRespond in English. Be practical, specific, and actionable. No generic advice.';
  var msgs = ((P().ai.chatHistory) || []).concat([{role:'user', content:msg}]);
  try {
    var res = await fetch('https://api.anthropic.com/v1/messages', {
      method:'POST',
      headers:{'Content-Type':'application/json','x-api-key':app.globalAI.apiKey,'anthropic-version':'2023-06-01','anthropic-dangerous-direct-browser-access':'true'},
      body:JSON.stringify({model:'claude-sonnet-4-6',max_tokens:1500,system:sys,messages:msgs.slice(-10)})
    });
    var data = await res.json();
    var reply = (data.content && data.content[0] && data.content[0].text) || 'Error getting response.';
    document.getElementById(lid) && document.getElementById(lid).remove();
    addChat('assistant', reply);
    P().ai.chatHistory = msgs.concat([{role:'assistant',content:reply}]).slice(-20);
    saveApp();
  } catch(e) {
    document.getElementById(lid) && document.getElementById(lid).remove();
    addChat('assistant', 'Error: ' + e.message);
  }
}
function addChat(role, text, id, loading) {
  var c = document.getElementById('chatMessages');
  var d = document.createElement('div');
  d.className = 'chat-msg ' + role + ' fade-up' + (loading?' loading':'');
  if (id) d.id = id;
  d.innerHTML = '<div class="chat-msg-label">' + (role==='user'?'You':'Assistant') + '</div><div class="chat-body">' + escHtml(text) + '</div>';
  c.appendChild(d); c.scrollTop = c.scrollHeight;
}

