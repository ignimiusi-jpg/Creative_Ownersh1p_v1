window._calMonth = new Date();
var _dragIdx = null;
function renderCalendar() {
  var yr = window._calMonth.getFullYear(), mo = window._calMonth.getMonth();
  document.getElementById('currentMonth').textContent = MONTHS[mo] + ' ' + yr;
  var first = new Date(yr, mo, 1);
  var start = new Date(first); start.setDate(start.getDate() - first.getDay());
  var today = new Date(); today.setHours(0,0,0,0);
  var release = new Date(P().releaseDate); release.setHours(0,0,0,0);
  var weekAhead = new Date(today); weekAhead.setDate(weekAhead.getDate() + 7);
  var allTasks = CAMPAIGN_STEPS.map(function(s){ return {s:s, date:getTaskDate(s.num), done:P().completedTasks.includes(s.num-1)}; });
  var html = '', cur = new Date(start);
  for (var cell = 0; cell < 42; cell++) {
    var isCurMo  = cur.getMonth() === mo;
    var isToday  = isSameDay(cur, today);
    var isRelDay = isSameDay(cur, release);
    var dayTasks = allTasks.filter(function(t){ return isSameDay(t.date, cur); });
    var dateStr  = cur.toISOString().split('T')[0];
    var cls = 'cal-cell' + (!isCurMo?' other-month':'') + (isToday?' today':'') + (isRelDay?' release-day':'');
    html += '<div class="' + cls + '" onclick="calSelectDay(\'' + cur.toISOString() + '\')" ' +
      'ondragover="event.preventDefault();this.classList.add(\'drag-over\')" ' +
      'ondragleave="this.classList.remove(\'drag-over\')" ' +
      'ondrop="calDrop(event,\'' + dateStr + '\',this)">' +
      '<span class="cal-num' + (isToday?' today-num':'') + (isRelDay?' release-num':'') + '">' + cur.getDate() + '</span>' +
      (isRelDay ? '<span class="cal-release-label">RELEASE</span>' : '') +
      '<div class="cal-tasks">';
    dayTasks.slice(0,3).forEach(function(t) {
      var isOvr = !t.done && t.date < today;
      var isTW  = !t.done && t.date >= today && t.date <= weekAhead;
      var cc = CAT_COLORS[t.s.cat] || CAT_COLORS.STRATEGY;
      var style = t.done ? 'background:rgba(16,185,129,.2);color:#6ee7b7' :
                  isOvr  ? 'background:rgba(239,68,68,.25);color:#fca5a5' :
                  isTW   ? 'background:rgba(245,158,11,.22);color:#fcd34d' :
                  'background:' + cc.hex + '22;color:' + cc.hex;
      html += '<div class="cal-task' + (t.done?' done':'') + '" style="' + style + '" draggable="true" ' +
        'ondragstart="_dragIdx=' + (t.s.num-1) + ';setTimeout(function(){this.style.opacity=\'.3\';},0)" ' +
        'ondragend="this.style.opacity=\'1\'" ' +
        'onclick="event.stopPropagation();toggleTask(' + (t.s.num-1) + ')" ' +
        'title="Step ' + t.s.num + ': ' + t.s.title + '">' +
        'S' + t.s.num + ': ' + t.s.title.slice(0,16) + (t.s.title.length > 16 ? '…' : '') + '</div>';
    });
    if (dayTasks.length > 3) html += '<div class="cal-more">+' + (dayTasks.length-3) + ' more</div>';
    html += '</div></div>';
    cur.setDate(cur.getDate() + 1);
  }
  document.getElementById('calendarGrid').innerHTML = html;
}
function calDrop(ev, dateStr, el) {
  ev.preventDefault(); el.classList.remove('drag-over');
  if (_dragIdx !== null) { P().taskDateOverrides[_dragIdx] = dateStr; _dragIdx = null; saveApp(); renderAll(); }
}
function changeMonth(d) { window._calMonth.setMonth(window._calMonth.getMonth() + d); renderCalendar(); }
function calSelectDay(iso) {
  var date = new Date(iso);
  var today = new Date(); today.setHours(0,0,0,0);
  var tasks = CAMPAIGN_STEPS.map(function(s){ return {s:s, date:getTaskDate(s.num), done:P().completedTasks.includes(s.num-1)}; }).filter(function(t){ return isSameDay(t.date, date); });
  if (!tasks.length) { document.getElementById('selectedDayTasks').classList.add('hidden'); return; }
  document.getElementById('selectedDayTasks').classList.remove('hidden');
  document.getElementById('selectedDayTitle').textContent = 'Tasks for ' + fmtFull(date);
  var html = '';
  tasks.forEach(function(t) {
    var isOvr = !t.done && t.date < today;
    var cc = CAT_COLORS[t.s.cat] || CAT_COLORS.STRATEGY;
    var hasMoved = P().taskDateOverrides[t.s.num-1] !== undefined;
    html += '<div onclick="toggleTask(' + (t.s.num-1) + ')" style="display:flex;align-items:center;gap:10px;padding:9px 11px;border-radius:9px;cursor:pointer;border:1px solid ' + (isOvr?'rgba(239,68,68,.2)':'var(--border)') + ';margin-bottom:6px">' +
      '<div class="check-box' + (t.done?' checked':'') + '">' +
      (t.done ? '<svg width="10" height="10" viewBox="0 0 12 12" fill="none"><path d="M2 6l3 3 5-5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>' : '') +
      '</div>' +
      '<div style="flex:1;min-width:0">' +
        '<div style="display:flex;align-items:center;gap:5px;flex-wrap:wrap;margin-bottom:3px">' +
          '<span class="tag ' + cc.cls + '">' + t.s.cat + '</span>' +
          (t.s.critical ? '<span class="tag cat-crit">Critical</span>' : '') +
          (isOvr ? '<span style="font-size:10px;color:#fca5a5">Overdue</span>' : '') +
        '</div>' +
        '<span style="font-size:13px;font-weight:600;' + (t.done?'text-decoration:line-through;color:var(--text3)':'') + '">Step ' + t.s.num + ': ' + escHtml(t.s.title) + '</span>' +
      '</div>' +
      (hasMoved ? '<button onclick="event.stopPropagation();resetTaskDate(' + (t.s.num-1) + ')" style="font-size:10px;color:var(--text3);background:none;border:none;cursor:pointer;padding:2px 6px;border-radius:5px;flex-shrink:0" title="Reset to auto date">↩ Reset</button>' : '') +
      '</div>';
  });
  document.getElementById('selectedDayTasksList').innerHTML = html;
}
function resetTaskDate(i) { delete P().taskDateOverrides[i]; saveApp(); renderAll(); }

// ══════════════════════════════════════════════════
// TIMELINE
// ══════════════════════════════════════════════════
window._phaseFilter = 'all';
function renderTimeline() {
  var today = new Date(); today.setHours(0,0,0,0);
  var filter = window._phaseFilter || 'all';
  var tasks = CAMPAIGN_STEPS.filter(function(s){ return filter === 'all' || s.phase === filter; })
    .map(function(s){ return {s:s, date:getTaskDate(s.num), done:P().completedTasks.includes(s.num-1)}; })
    .sort(function(a,b){ return a.date - b.date; });
  document.getElementById('timelineCompleted').textContent = P().completedTasks.length;
  document.getElementById('tlTotal').textContent = CAMPAIGN_STEPS.length;
  var html = '<div class="tl-line"></div>';
  tasks.forEach(function(t, i) {
    var isOvr = !t.done && t.date < today;
    var isCur = isSameDay(t.date, today);
    var hasMoved = P().taskDateOverrides[t.s.num-1] !== undefined;
    var wk = STEP_WEEK[t.s.num] || 0;
    var wkLabel = wk === 0 ? 'LAUNCH' : (wk > 0 ? '+' + wk : wk) + 'wk';
    var dotCls = 'tl-dot' + (t.done?' done':isCur?' current':isOvr?' overdue':'');
    var cc = CAT_COLORS[t.s.cat] || CAT_COLORS.STRATEGY;
    html += '<div class="tl-item" style="animation-delay:' + (i*.035) + 's">' +
      '<div class="tl-date">' +
        '<span style="' + (isOvr?'color:#fca5a5':isCur?'color:#fcd34d;font-weight:700':'') + '">' + fmtDate(t.date) + '</span>' +
        '<span class="tl-week">' + wkLabel + '</span>' +
        (hasMoved ? '<span class="tl-moved">moved</span>' : '') +
      '</div>' +
      '<div class="' + dotCls + '"></div>' +
      '<div onclick="toggleTask(' + (t.s.num-1) + ')" class="tl-card' + (isOvr?' overdue':'') + (t.done?' done-card':'') + '">' +
        '<div class="tl-card-meta">' +
          '<span class="tag ' + cc.cls + '">' + t.s.cat + '</span>' +
          (t.s.critical ? '<span class="tag cat-crit">Critical</span>' : '') +
          '<span style="font-size:10px;color:var(--text3)">Step ' + t.s.num + '</span>' +
          (t.done   ? '<span style="font-size:10px;color:#6ee7b7;margin-left:auto">Done ✓</span>' : '') +
          (isOvr    ? '<span style="font-size:10px;color:#fca5a5;margin-left:auto">Overdue</span>' : '') +
          (isCur&&!t.done ? '<span style="font-size:10px;color:#fcd34d;margin-left:auto">Today</span>' : '') +
        '</div>' +
        '<div style="font-size:13px;font-weight:600;' + (t.done?'text-decoration:line-through;color:var(--text3)':'') + '">' + escHtml(t.s.title) + '</div>' +
      '</div>' +
    '</div>';
  });
  document.getElementById('timelineContainer').innerHTML = html;
}
function filterPhase(phase, btn) {
  window._phaseFilter = phase;
  document.querySelectorAll('#phaseFilters .phase-btn').forEach(function(b){ b.classList.remove('active'); });
  btn.classList.add('active');
  renderTimeline();
}

