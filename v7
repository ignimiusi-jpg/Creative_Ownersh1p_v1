    .replace('{name}',     p.name)
    .replace(/{genre}/g,   ai.genre     || 'Indie')
    .replace(/{mood}/g,    ai.mood      || 'melodic and nostalgic')
    .replace(/{audience}/g,ai.audience  || '18-28')
