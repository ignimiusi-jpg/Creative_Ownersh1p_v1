<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Creative Ownership | Launch Command v7</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#07070d;--bg1:#0f0f1a;--bg2:#151524;
  --border:#1e1e30;--border2:#2c2c42;
  --text:#eeeef5;--text2:#9090b0;--text3:#4a4a65;
  --violet:#6d28d9;--violet2:#a78bfa;
  --pink:#be185d;--green:#1db954;
  --emerald:#10b981;--rose:#ef4444;
  --amber:#f59e0b;--cyan:#06b6d4;--blue:#3b82f6;
  --font:'DM Sans',sans-serif;--mono:'DM Mono',monospace;
  --r:10px;--r2:14px;
}
html,body{height:100%;overflow:hidden}
body{font-family:var(--font);background:var(--bg);color:var(--text);font-size:14px;line-height:1.5}
::-webkit-scrollbar{width:4px;height:4px}
::-webkit-scrollbar-thumb{background:var(--border2);border-radius:4px}
a{color:var(--violet2);text-decoration:none}a:hover{text-decoration:underline}
button{cursor:pointer;font-family:var(--font);border:none}
input,textarea,select{font-family:var(--font);font-size:13px;background:var(--bg1);border:1px solid var(--border2);color:var(--text);padding:8px 12px;border-radius:var(--r);outline:none;width:100%;transition:border-color .15s,box-shadow .15s}
input:focus,textarea:focus,select:focus{border-color:var(--violet);box-shadow:0 0 0 3px rgba(109,40,217,.1)}
input[type="date"]{cursor:pointer}
select option{background:var(--bg2)}
textarea{resize:vertical;line-height:1.6}

/* ── LAYOUT ── */
.app{display:flex;height:100vh;overflow:hidden}
.sidebar{width:244px;min-width:244px;background:rgba(7,7,13,.97);border-right:1px solid var(--border);display:flex;flex-direction:column}
.main{flex:1;display:flex;flex-direction:column;min-width:0}
.main-header{height:58px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;padding:0 20px;background:rgba(7,7,13,.9);flex-shrink:0}
.main-body{flex:1;overflow-y:auto;padding:20px}

/* ── SIDEBAR ── */
.sidebar-brand{padding:14px 16px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:10px}
.brand-icon{width:34px;height:34px;border-radius:9px;background:var(--violet);display:flex;align-items:center;justify-content:center;font-size:16px;font-weight:900;flex-shrink:0;color:#fff}
.brand-name{font-weight:800;font-size:13px;line-height:1.2}
.brand-sub{font-size:10px;color:var(--text3);font-family:var(--mono)}
.project-switcher{padding:10px 12px;border-bottom:1px solid var(--border)}
.pswitch-label{font-size:9px;text-transform:uppercase;letter-spacing:.1em;color:var(--text3);margin-bottom:7px;font-weight:700}
.project-dropdown{position:relative}
.project-current{background:var(--bg1);border:1px solid var(--border2);border-radius:var(--r);padding:8px 10px;cursor:pointer;display:flex;align-items:center;gap:8px;transition:border-color .15s}
.project-current:hover{border-color:var(--violet)}
.project-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}
.project-current-name{font-weight:600;font-size:13px;flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.project-arrow{font-size:10px;color:var(--text3)}
.project-menu{display:none;position:absolute;top:calc(100% + 4px);left:0;right:0;background:var(--bg1);border:1px solid var(--border2);border-radius:var(--r);z-index:200;overflow:hidden;box-shadow:0 8px 32px rgba(0,0,0,.6)}
.project-menu.open{display:block}
.project-menu-item{padding:9px 12px;cursor:pointer;display:flex;align-items:center;gap:8px;font-size:13px;transition:background .1s}
.project-menu-item:hover{background:var(--bg2)}
.project-menu-item.active{color:var(--violet2)}
.project-menu-item .del-btn{margin-left:auto;font-size:11px;color:var(--text3);opacity:0;transition:opacity .15s;padding:2px 4px;border-radius:4px;background:none}
.project-menu-item:hover .del-btn{opacity:1}
.project-menu-item .del-btn:hover{color:var(--rose);background:rgba(239,68,68,.1)}
.project-add{padding:9px 12px;border-top:1px solid var(--border);cursor:pointer;font-size:12px;color:var(--violet2);display:flex;align-items:center;gap:6px;transition:background .1s}
.project-add:hover{background:rgba(109,40,217,.08)}
.nav-section{padding:8px 8px 2px;font-size:9px;text-transform:uppercase;letter-spacing:.1em;color:var(--text3);font-weight:700;margin-top:6px}
.nav{flex:1;padding:4px 8px 8px;overflow-y:auto}
.nav-item{display:flex;align-items:center;gap:9px;padding:8px 11px;border-radius:var(--r);font-size:13px;font-weight:500;color:var(--text2);cursor:pointer;width:100%;background:none;text-align:left;transition:all .15s;border-left:2px solid transparent;margin-bottom:1px}
.nav-item:hover{color:var(--text);background:rgba(255,255,255,.04)}
.nav-item.active{background:rgba(109,40,217,.12);color:var(--violet2);border-left-color:var(--violet)}
.nav-icon{font-size:14px;width:18px;text-align:center;flex-shrink:0}
.sidebar-footer{padding:10px 12px;border-top:1px solid var(--border)}
.btn-secondary{background:var(--bg2);border:1px solid var(--border2);color:var(--text2);padding:8px 14px;border-radius:var(--r);font-size:12px;font-weight:600;width:100%;transition:all .15s}
.btn-secondary:hover{background:var(--border);color:var(--text)}

/* ── COMPONENTS ── */
.card{background:rgba(15,15,26,.9);border:1px solid var(--border);border-radius:var(--r2)}
.card-p{padding:18px}
.card-title{font-size:10px;text-transform:uppercase;letter-spacing:.1em;color:var(--text3);font-weight:700;margin-bottom:12px}
.progress-bar{height:4px;background:var(--border);border-radius:10px;overflow:hidden}
.progress-fill{height:100%;background:linear-gradient(90deg,var(--violet),var(--pink));border-radius:10px;transition:width .4s cubic-bezier(.4,0,.2,1)}
.badge{display:inline-flex;align-items:center;gap:3px;font-size:10px;font-weight:700;padding:2px 7px;border-radius:6px;letter-spacing:.04em}
.tag{display:inline-block;font-size:10px;font-weight:700;padding:2px 6px;border-radius:5px;letter-spacing:.03em;white-space:nowrap}
.header-field label{display:block;font-size:9px;text-transform:uppercase;letter-spacing:.1em;color:var(--text3);margin-bottom:2px}
.header-field input{background:transparent;border:none;font-size:14px;font-weight:700;padding:0;border-bottom:1px solid transparent;border-radius:0;width:auto;transition:border-color .15s}
.header-field input:focus{border-bottom-color:var(--violet);box-shadow:none}
.header-field input[type="date"]{font-family:var(--mono);color:var(--violet2);font-size:12px}
.divider{width:1px;height:28px;background:var(--border);margin:0 8px}
.countdown{padding:6px 14px;border-radius:var(--r);font-family:var(--mono);font-weight:700;font-size:12px}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.grid3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px}
.grid4{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
.stack{display:flex;flex-direction:column;gap:12px}
.row{display:flex;align-items:center;gap:10px}
.row-between{display:flex;align-items:center;justify-content:space-between}
.nowrap{white-space:nowrap}
.stat-card{padding:16px;position:relative}
.stat-label{font-size:9px;text-transform:uppercase;letter-spacing:.12em;color:var(--text3);font-weight:700;margin-bottom:7px}
.stat-value{font-size:24px;font-weight:800;font-family:var(--mono);line-height:1}
.stat-sub{font-size:11px;color:var(--text3);margin-top:3px}
.btn{display:inline-flex;align-items:center;gap:6px;padding:8px 14px;border-radius:var(--r);font-size:13px;font-weight:600;cursor:pointer;transition:all .15s;border:1px solid transparent;font-family:var(--font)}
.btn-primary{background:var(--violet);color:#fff}
.btn-primary:hover{background:#5b21b6}
.btn-ghost{background:var(--bg2);border-color:var(--border2);color:var(--text2)}
.btn-ghost:hover{background:var(--border);color:var(--text)}
.btn-green{background:var(--green);color:#000;font-weight:700}
.btn-green:hover{background:#1ed760}
.btn-small{padding:5px 10px;font-size:11px;border-radius:7px}
.link-btn{background:none;border:none;padding:0;font-size:12px;font-weight:600;cursor:pointer;font-family:var(--font)}
.tab-content{display:none}
.tab-content.active{display:block}
.inner-tabs{display:flex;gap:2px;border-bottom:1px solid var(--border);margin-bottom:14px}
.inner-tab{background:none;border:none;padding:9px 14px;font-size:13px;font-weight:600;color:var(--text2);cursor:pointer;border-bottom:2px solid transparent;margin-bottom:-1px;transition:all .15s;font-family:var(--font)}
.inner-tab:hover{color:var(--text)}
.inner-tab.active{color:var(--violet2);border-bottom-color:var(--violet)}
.inner-tab-content{display:none}
.inner-tab-content.active{display:block}
.phase-filters{display:flex;gap:6px;flex-wrap:wrap}
.phase-btn{background:var(--bg2);border:1px solid var(--border2);color:var(--text2);padding:4px 11px;border-radius:20px;font-size:11px;font-weight:700;cursor:pointer;transition:all .15s;font-family:var(--font)}
.phase-btn:hover{border-color:var(--violet);color:var(--violet2)}
.phase-btn.active{background:rgba(109,40,217,.2);border-color:var(--violet);color:var(--violet2)}

/* ── CALENDAR ── */
.cal-header-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:3px}
.cal-day-hdr{text-align:center;font-size:10px;font-weight:700;color:var(--text3);text-transform:uppercase;letter-spacing:.08em;padding:6px 0}
.cal-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:3px}
.cal-cell{min-height:80px;background:var(--bg1);border:1px solid var(--border);border-radius:8px;padding:6px;cursor:pointer;transition:border-color .15s}
.cal-cell:hover{border-color:var(--border2)}
.cal-cell.other-month{opacity:.2}
.cal-cell.today{border-color:var(--violet)}
.cal-cell.release-day{background:linear-gradient(135deg,rgba(109,40,217,.25),rgba(190,24,93,.2));border-color:var(--violet)}
.cal-cell.drag-over{border-color:var(--violet);background:rgba(109,40,217,.12)}
.cal-num{font-size:11px;font-weight:700;color:var(--text3)}
.cal-num.today-num{color:var(--violet2)}
.cal-num.release-num{color:#fff}
.cal-release-label{font-size:9px;color:rgba(255,255,255,.6);margin-top:1px;display:block}
.cal-tasks{margin-top:4px;display:flex;flex-direction:column;gap:2px}
.cal-task{font-size:10px;padding:2px 5px;border-radius:4px;cursor:grab;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;user-select:none}
.cal-task.done{opacity:.35;text-decoration:line-through}
.cal-more{font-size:9px;color:var(--text3);padding:1px 4px}

/* ── TIMELINE ── */
.tl-wrap{position:relative;padding-bottom:2px}
.tl-line{position:absolute;left:104px;top:0;bottom:0;width:2px;background:linear-gradient(to bottom,var(--violet),rgba(28,28,46,.3))}
.tl-item{position:relative;padding-left:124px;padding-bottom:14px;animation:fadeUp .25s ease both}
.tl-date{position:absolute;left:0;top:2px;width:92px;text-align:right;font-size:11px;color:var(--text3);font-family:var(--mono);line-height:1.4}
.tl-week{font-size:9px;display:block}
.tl-moved{font-size:9px;color:var(--violet);display:block}
.tl-dot{position:absolute;left:97px;top:6px;width:14px;height:14px;border-radius:50%;border:2px solid var(--border);background:var(--bg);transition:all .2s}
.tl-dot.done{background:var(--violet);border-color:var(--violet);box-shadow:0 0 10px rgba(109,40,217,.5)}
.tl-dot.current{background:var(--amber);border-color:var(--amber);box-shadow:0 0 10px rgba(245,158,11,.7)}
.tl-dot.overdue{background:var(--rose);border-color:var(--rose)}
.tl-card{background:var(--bg1);border:1px solid var(--border);border-radius:var(--r);padding:11px 13px;cursor:pointer;transition:border-color .15s}
.tl-card:hover{border-color:var(--border2)}
.tl-card.overdue{border-color:rgba(239,68,68,.3)}
.tl-card.done-card{opacity:.45}
.tl-card-meta{display:flex;align-items:center;gap:6px;margin-bottom:5px;flex-wrap:wrap}

/* ── SPLITS ── */
.split-bar{height:26px;border-radius:8px;overflow:hidden;display:flex}
.split-bar-seg{height:100%;transition:width .4s}
.split-item{background:rgba(15,15,26,.7);border:1px solid var(--border);border-radius:var(--r);padding:11px 13px;display:flex;align-items:center;gap:10px;margin-bottom:6px}
.split-color-bar{width:4px;height:30px;border-radius:3px;flex-shrink:0}
.split-inputs{flex:1;min-width:0}
.split-input-name,.split-input-role{background:transparent;border:none;width:100%;padding:0;color:var(--text)}
.split-input-name{font-weight:600;font-size:13px}
.split-input-role{font-size:11px;color:var(--text3);margin-top:2px}
.split-input-name:focus,.split-input-role:focus{outline:none}
.split-pct{width:52px;text-align:center;font-size:15px;font-weight:700;font-family:var(--mono);background:var(--bg2);border:1px solid var(--border2);border-radius:8px;padding:4px}

/* ── BUDGET ── */
.budget-item{background:rgba(15,15,26,.6);border:1px solid var(--border);border-radius:var(--r);padding:12px 13px;margin-bottom:6px}
.budget-total-input{font-family:var(--mono);font-size:24px;font-weight:800;background:transparent;border:none;border-bottom:1px dashed var(--border2);padding:0 0 2px;color:var(--text);outline:none;width:130px}
.budget-total-input:focus{border-bottom-color:var(--violet)}
.budget-num{width:78px;background:var(--bg2);border:1px solid var(--border2);border-radius:7px;padding:5px 8px;font-family:var(--mono);font-size:13px;text-align:right}

/* ── SPOTIFY ── */
.spotify-card{background:linear-gradient(145deg,rgba(29,185,84,.07),rgba(13,13,20,.9));border:1px solid rgba(29,185,84,.22);border-radius:var(--r2)}
.spotify-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
.spotify-stat{padding:12px 13px}
.spotify-stat-label{font-size:10px;color:var(--text3);text-transform:uppercase;letter-spacing:.08em;margin-bottom:5px}
.spotify-stat-val{font-size:20px;font-weight:800;font-family:var(--mono)}

/* ── PR TABLE ── */
.pr-table{width:100%;border-collapse:collapse}
.pr-table th{font-size:9px;text-transform:uppercase;letter-spacing:.1em;color:var(--text3);padding:9px 13px;text-align:left;background:rgba(15,15,26,.5);font-weight:700}
.pr-table td{padding:9px 13px;border-top:1px solid var(--border);font-size:13px;vertical-align:middle}
.pr-table tr:hover td{background:rgba(255,255,255,.02)}
.pr-table input{background:transparent;border:none;padding:0;font-size:13px;width:100%}
.pr-table input:focus{outline:none}

/* ── CHAT ── */
.chat-window{height:320px;overflow-y:auto;display:flex;flex-direction:column;gap:10px;padding:4px}
.chat-msg{padding:11px 13px;border-radius:var(--r);font-size:13px;line-height:1.65}
.chat-msg.user{background:rgba(109,40,217,.1);border:1px solid rgba(109,40,217,.18);margin-left:40px}
.chat-msg.assistant{background:var(--bg1);border:1px solid var(--border);margin-right:40px}
.chat-msg.loading{opacity:.55}
.chat-msg-label{font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.1em;margin-bottom:5px}
.chat-msg.user .chat-msg-label{color:var(--violet2)}
.chat-msg.assistant .chat-msg-label{color:var(--text3)}
.chat-msg .chat-body{white-space:pre-wrap}
.quick-prompts{display:flex;flex-wrap:wrap;gap:6px}
.quick-btn{background:var(--bg2);border:1px solid var(--border2);color:var(--text2);padding:5px 10px;border-radius:7px;font-size:11px;font-weight:600;cursor:pointer;transition:all .15s;font-family:var(--font)}
.quick-btn:hover{border-color:var(--violet);color:var(--violet2);background:rgba(109,40,217,.08)}

/* ── ALERTS ── */
.alert{padding:11px 15px;border-radius:var(--r);border:1px solid}
.alert-rose{background:rgba(239,68,68,.05);border-color:rgba(239,68,68,.25);color:#fca5a5}

/* ── UPCOMING ── */
.upcoming-item{display:flex;align-items:center;gap:10px;padding:9px 11px;border-radius:var(--r);border:1px solid;cursor:pointer;transition:background .1s;margin-bottom:5px}
.upcoming-item:hover{background:rgba(255,255,255,.03)}
.upcoming-item.normal{border-color:rgba(30,30,48,.6)}
.upcoming-item.overdue{border-color:rgba(239,68,68,.2);background:rgba(239,68,68,.03)}
.upcoming-item.today{border-color:rgba(245,158,11,.2);background:rgba(245,158,11,.03)}
.check-box{width:17px;height:17px;border-radius:5px;border:2px solid var(--border2);display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:all .15s}
.check-box.checked{background:var(--violet);border-color:var(--violet)}
.ring-svg{position:absolute;top:14px;right:14px}

/* ── SOCIAL ── */
.social-platform-toggle{display:flex;background:var(--bg2);border:1px solid var(--border2);border-radius:11px;padding:3px;width:fit-content}
.platform-btn{padding:7px 18px;border-radius:8px;font-size:13px;font-weight:700;border:none;background:transparent;color:var(--text3);cursor:pointer;transition:all .2s;display:flex;align-items:center;gap:7px;font-family:var(--font)}
.platform-btn.active.tiktok{background:#000;color:#fff;box-shadow:0 2px 12px rgba(0,0,0,.5)}
.platform-btn.active.instagram{background:linear-gradient(135deg,#f09433,#e6683c,#dc2743,#cc2366,#bc1888);color:#fff}
.platform-btn:not(.active):hover{color:var(--text)}
.audit-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
.audit-stat{background:var(--bg1);border:1px solid var(--border);border-radius:var(--r);padding:13px 15px}
.audit-stat-label{font-size:10px;text-transform:uppercase;letter-spacing:.08em;color:var(--text3);font-weight:700;margin-bottom:7px}
.audit-stat-val{font-size:21px;font-weight:800;font-family:var(--mono)}
.audit-stat-sub{font-size:11px;color:var(--text3);margin-top:3px}
.eng-score{width:80px;height:80px}
.audit-history-table{width:100%;border-collapse:collapse}
.audit-history-table th{font-size:9px;text-transform:uppercase;letter-spacing:.1em;color:var(--text3);padding:9px 13px;text-align:left;background:rgba(15,15,26,.5);font-weight:700;border-bottom:1px solid var(--border)}
.audit-history-table td{padding:9px 13px;border-bottom:1px solid rgba(28,28,46,.5);font-size:12px;vertical-align:middle}
.audit-history-table tr:last-child td{border-bottom:none}
.audit-history-table tr:hover td{background:rgba(255,255,255,.02)}
.eng-chip{display:inline-block;padding:2px 8px;border-radius:6px;font-family:var(--mono);font-size:11px;font-weight:700}
.eng-great{background:rgba(16,185,129,.2);color:#6ee7b7}
.eng-good{background:rgba(245,158,11,.2);color:#fcd34d}
.eng-low{background:rgba(239,68,68,.2);color:#fca5a5}
.benchmark-row{display:flex;align-items:center;justify-content:space-between;padding:7px 0;border-bottom:1px solid rgba(28,28,46,.5)}
.benchmark-row:last-child{border-bottom:none}
.tiktok-grad{background:linear-gradient(135deg,#010101,#1a1a1a);border:1px solid rgba(255,255,255,.08)}
.ig-grad{background:linear-gradient(135deg,rgba(240,148,51,.08),rgba(188,24,136,.08));border:1px solid rgba(188,24,136,.2)}

/* ── STRATEGY INDEX ── */
.idx-section{margin-bottom:20px}
.idx-section-header{display:flex;align-items:center;gap:10px;padding:12px 16px;background:var(--bg1);border:1px solid var(--border);border-radius:var(--r2) var(--r2) 0 0;border-bottom:none}
.idx-section-icon{font-size:20px}
.idx-section-title{font-weight:800;font-size:14px;flex:1}
.idx-section-prog{font-size:11px;color:var(--text3);font-family:var(--mono)}
.idx-table{width:100%;border-collapse:collapse;background:var(--bg1);border:1px solid var(--border);border-radius:0 0 var(--r2) var(--r2);overflow:hidden}
.idx-table th{font-size:9px;text-transform:uppercase;letter-spacing:.1em;color:var(--text3);padding:9px 16px;text-align:left;background:rgba(15,15,26,.8);font-weight:700}
.idx-table td{padding:11px 16px;border-top:1px solid var(--border);vertical-align:middle}
.idx-table tr:hover td{background:rgba(255,255,255,.02)}
.idx-item-name{font-size:13px;font-weight:600;display:flex;align-items:center;gap:8px}
.idx-item-icon{font-size:14px}
.idx-status-btn{padding:4px 10px;border-radius:20px;font-size:11px;font-weight:700;border:1px solid;cursor:pointer;transition:all .15s;font-family:var(--font);white-space:nowrap}
.idx-status-ns{background:rgba(74,74,101,.2);border-color:rgba(74,74,101,.4);color:var(--text3)}
.idx-status-ip{background:rgba(245,158,11,.15);border-color:rgba(245,158,11,.4);color:#fcd34d}
.idx-status-done{background:rgba(16,185,129,.15);border-color:rgba(16,185,129,.35);color:#6ee7b7}
.idx-section-progress-bar{height:3px;background:var(--border);border-radius:0;overflow:hidden}
.idx-section-progress-fill{height:100%;transition:width .4s;border-radius:0}

/* ── MODAL ── */
.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.75);display:none;align-items:center;justify-content:center;z-index:1000;backdrop-filter:blur(4px)}
.modal-overlay.open{display:flex}
.modal{background:var(--bg1);border:1px solid var(--border2);border-radius:var(--r2);padding:22px;width:400px;max-width:90vw;animation:fadeUp .2s ease}
.modal h3{font-size:15px;font-weight:800;margin-bottom:5px}
.modal p{font-size:13px;color:var(--text2);margin-bottom:18px}
.modal-field{margin-bottom:12px}
.modal-field label{display:block;font-size:11px;color:var(--text3);text-transform:uppercase;letter-spacing:.08em;margin-bottom:5px;font-weight:700}
.modal-actions{display:flex;gap:8px;margin-top:18px}
.modal-actions .btn{flex:1;justify-content:center}

/* ── CATEGORY COLORS ── */
.cat-AUDIO{background:rgba(6,182,212,.18);color:#67e8f9}
.cat-LEGAL{background:rgba(244,63,94,.18);color:#fda4af}
.cat-VISUAL{background:rgba(217,70,239,.18);color:#f0abfc}
.cat-DIST{background:rgba(59,130,246,.18);color:#93c5fd}
.cat-PR{background:rgba(245,158,11,.18);color:#fcd34d}
.cat-CONTENT{background:rgba(16,185,129,.18);color:#6ee7b7}
.cat-GROWTH{background:rgba(249,115,22,.18);color:#fdba74}
.cat-ANALYTICS{background:rgba(99,102,241,.18);color:#c7d2fe}
.cat-STRATEGY{background:rgba(139,92,246,.18);color:#c4b5fd}
.cat-crit{background:rgba(239,68,68,.18);color:#fca5a5}

/* ── MISC ── */
@keyframes fadeUp{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
.fade-up{animation:fadeUp .25s ease both}
.hidden{display:none!important}
.text-rose{color:#fca5a5}.text-amber{color:#fcd34d}.text-emerald{color:#6ee7b7}
.text-violet{color:var(--violet2)}.text-green{color:var(--green)}.text-muted{color:var(--text3)}
.text-sm{font-size:12px}.mono-text{font-family:var(--mono)}
.info-box{background:rgba(109,40,217,.06);border:1px solid rgba(109,40,217,.15);border-radius:var(--r);padding:13px 15px}
.info-box ol{padding-left:16px}
.info-box li{margin-bottom:4px;color:var(--text2);font-size:12px}
hr{border:none;border-top:1px solid var(--border);margin:14px 0}
.select-sm{background:var(--bg2);border:1px solid var(--border2);color:var(--text2);padding:4px 8px;border-radius:7px;font-size:11px;font-family:var(--font);cursor:pointer}
.select-sm:focus{border-color:var(--violet);outline:none}
.legend-dot{width:9px;height:9px;border-radius:3px;flex-shrink:0}
.legend-row{display:flex;align-items:center;gap:6px;font-size:11px;color:var(--text3)}
.legend-wrap{display:flex;flex-wrap:wrap;gap:12px}
.step-desc{background:rgba(109,40,217,.04);border:1px solid rgba(109,40,217,.1);border-radius:8px;padding:9px 12px;margin-top:7px;font-size:12px;color:var(--text2);line-height:1.65}
</style>
</head>
<body>

<!-- NEW PROJECT MODAL -->
<div class="modal-overlay" id="newProjectModal">
  <div class="modal fade-up">
    <h3>New Release ✨</h3>
    <p>Each release has its own timeline, splits, budget and metrics.</p>
    <div class="modal-field"><label>Release Name</label><input type="text" id="newProjectName" placeholder="e.g. Nostalgia EP, Summer 2025..."></div>
    <div class="modal-field"><label>Release Date</label><input type="date" id="newProjectDate"></div>
    <div class="modal-field"><label>Genre</label><input type="text" id="newProjectGenre" placeholder="Latin Soul, Trap, Indie..."></div>
    <div class="modal-actions">
      <button class="btn btn-ghost" onclick="closeNewProjectModal()">Cancel</button>
      <button class="btn btn-primary" onclick="createProject()">Create Release</button>
    </div>
  </div>
</div>

<div class="app">
<!-- ══ SIDEBAR ══ -->
<aside class="sidebar">
  <div class="sidebar-brand">
    <div class="brand-icon">◉</div>
    <div><div class="brand-name">Creative Ownership</div><div class="brand-sub">Launch Command v7</div></div>
  </div>
  <div class="project-switcher">
    <div class="pswitch-label">Active Release</div>
    <div class="project-dropdown" id="projectDropdown">
      <div class="project-current" onclick="toggleProjectMenu()">
        <div class="project-dot" id="activeProjectDot"></div>
        <span class="project-current-name" id="activeProjectLabel">—</span>
        <span class="project-arrow">▾</span>
      </div>
      <div class="project-menu" id="projectMenu">
        <div id="projectMenuItems"></div>
        <div class="project-add" onclick="openNewProjectModal()">＋ New Release</div>
      </div>
    </div>
  </div>
  <div class="nav" id="mainNav">
    <div class="nav-section">Overview</div>
    <button class="nav-item active" onclick="switchTab('command')"><span class="nav-icon">◉</span> Command Center</button>
    <div class="nav-section">Planning</div>
    <button class="nav-item" onclick="switchTab('campaign')"><span class="nav-icon">📋</span> Campaign Steps</button>
    <button class="nav-item" onclick="switchTab('index')"><span class="nav-icon">📚</span> Strategy Index</button>
    <button class="nav-item" onclick="switchTab('calendar')"><span class="nav-icon">📅</span> Calendar</button>
    <button class="nav-item" onclick="switchTab('timeline')"><span class="nav-icon">⏱</span> Timeline</button>
    <div class="nav-section">Analytics</div>
    <button class="nav-item" onclick="switchTab('spotify')"><span class="nav-icon">🎵</span> Spotify</button>
    <button class="nav-item" onclick="switchTab('social')"><span class="nav-icon">📲</span> Social Media</button>
    <div class="nav-section">Finance & Legal</div>
    <button class="nav-item" onclick="switchTab('splits')"><span class="nav-icon">✂</span> SPLIT$</button>
    <button class="nav-item" onclick="switchTab('budget')"><span class="nav-icon">💰</span> Budget</button>
    <div class="nav-section">Growth</div>
    <button class="nav-item" onclick="switchTab('outreach')"><span class="nav-icon">📡</span> PR + AI Ideas</button>
  </div>
  <div class="sidebar-footer">
    <button class="btn-secondary" onclick="exportData()">📥 Export JSON</button>
  </div>
</aside>

<!-- ══ MAIN ══ -->
<main class="main">
  <header class="main-header">
    <div class="row" style="gap:10px">
      <div class="header-field">
        <label>Release</label>
        <input type="text" id="projectName" style="width:190px">
      </div>
      <div class="divider"></div>
      <div class="header-field">
        <label>Release Date</label>
        <input type="date" id="releaseDate">
      </div>
    </div>
    <div class="countdown" id="countdown"></div>
  </header>
  <div class="main-body">

  <!-- ═══ COMMAND CENTER ═══ -->
  <div id="command" class="tab-content active stack">
    <div id="spotifyWidget"></div>
    <div class="grid4">
      <div class="card stat-card">
        <svg id="readinessRing" class="ring-svg" width="58" height="58"></svg>
        <div class="stat-label">Readiness</div>
        <div class="stat-value" id="readinessLabel" style="font-size:16px;margin-top:4px">Setup</div>
      </div>
      <div class="card stat-card">
        <div class="stat-label">Tasks</div>
        <div class="stat-value mono-text"><span id="tasksCompleted">0</span><span style="color:var(--text3)">/</span><span id="totalTasksCount" style="color:var(--text3)">16</span></div>
        <div class="progress-bar" style="margin-top:8px"><div class="progress-fill" id="tasksProgress" style="width:0%"></div></div>
      </div>
      <div class="card stat-card">
        <div class="stat-label">Budget Spent</div>
        <div class="stat-value mono-text">$<span id="budgetSpent">0</span></div>
        <div class="stat-sub">of $<span id="budgetTotalHeader">500</span></div>
      </div>
      <div class="card stat-card">
        <div class="stat-label">SPLIT$</div>
        <div class="stat-value mono-text" id="splitsTotal">100%</div>
        <div class="stat-sub" id="splitsStatus">Balanced</div>
      </div>
    </div>
    <div class="alert alert-rose hidden" id="overdueAlert" style="display:flex;align-items:center;justify-content:space-between">
      <span>⚠ <span id="overdueCount">0</span> overdue tasks</span>
      <button class="link-btn text-rose" onclick="switchTab('timeline')">View timeline →</button>
    </div>
    <div class="card card-p">
      <div class="row-between" style="margin-bottom:10px">
        <div class="card-title" style="margin-bottom:0">Upcoming Tasks</div>
        <button class="link-btn text-violet" onclick="switchTab('calendar')">View calendar →</button>
      </div>
      <div id="upcomingTasks"></div>
    </div>
    <div class="card card-p">
      <div class="card-title">Strategic Edge</div>
      <textarea id="secretInput" rows="3" placeholder="What truth do you know that the market doesn't see yet?"></textarea>
    </div>
  </div>

  <!-- ═══ CAMPAIGN STEPS ═══ -->
  <div id="campaign" class="tab-content stack">
    <div class="row-between">
      <div>
        <div style="font-size:18px;font-weight:800">Campaign Steps</div>
        <div style="font-size:12px;color:var(--text3);margin-top:3px">Professional single/album release guide — click any step to toggle complete</div>
      </div>
      <div class="row" style="gap:8px">
        <span style="font-size:12px;color:var(--text3)">Completed</span>
        <span style="font-weight:700;font-family:var(--mono);font-size:14px"><span id="campaignCompleted">0</span>/<span id="campaignTotal">16</span></span>
      </div>
    </div>
    <div class="phase-filters" id="campaignPhaseFilters">
      <button class="phase-btn active" onclick="filterCampaignPhase('all',this)">All Steps</button>
      <button class="phase-btn" onclick="filterCampaignPhase('pre',this)">Pre-Release</button>
      <button class="phase-btn" onclick="filterCampaignPhase('during',this)">During Release</button>
      <button class="phase-btn" onclick="filterCampaignPhase('post',this)">Post-Release</button>
    </div>
    <div id="campaignStepsContainer" class="stack"></div>
  </div>

  <!-- ═══ STRATEGY INDEX ═══ -->
  <div id="index" class="tab-content stack">
    <div>
      <div style="font-size:18px;font-weight:800">Strategy Index</div>
      <div style="font-size:12px;color:var(--text3);margin-top:3px">All release strategy tools, templates and guides — track your progress across each area</div>
    </div>
    <div id="strategyIndexContainer" class="stack"></div>
  </div>

  <!-- ═══ CALENDAR ═══ -->
  <div id="calendar" class="tab-content stack">
    <div class="row-between">
      <div>
        <div style="font-size:18px;font-weight:800">Launch Calendar</div>
        <div style="font-size:12px;color:var(--text3);margin-top:3px">Drag tasks between days to reschedule</div>
      </div>
      <div class="row" style="gap:8px">
        <button class="btn btn-ghost btn-small" onclick="changeMonth(-1)">←</button>
        <span id="currentMonth" style="font-weight:700;font-family:var(--mono);font-size:13px;width:150px;text-align:center"></span>
        <button class="btn btn-ghost btn-small" onclick="changeMonth(1)">→</button>
      </div>
    </div>
    <div class="legend-wrap">
      <div class="legend-row"><div class="legend-dot" style="background:linear-gradient(90deg,var(--violet),var(--pink))"></div>Release Day</div>
      <div class="legend-row"><div class="legend-dot" style="background:var(--rose)"></div>Overdue</div>
      <div class="legend-row"><div class="legend-dot" style="background:var(--amber)"></div>This week</div>
      <div class="legend-row"><div class="legend-dot" style="background:var(--emerald)"></div>Completed</div>
      <div class="legend-row"><div class="legend-dot" style="border:2px solid var(--violet);background:transparent"></div>Today</div>
    </div>
    <div class="cal-header-grid">
      <div class="cal-day-hdr">Sun</div><div class="cal-day-hdr">Mon</div><div class="cal-day-hdr">Tue</div>
      <div class="cal-day-hdr">Wed</div><div class="cal-day-hdr">Thu</div><div class="cal-day-hdr">Fri</div><div class="cal-day-hdr">Sat</div>
    </div>
    <div class="cal-grid" id="calendarGrid"></div>
    <div class="card card-p hidden fade-up" id="selectedDayTasks">
      <div class="card-title" id="selectedDayTitle">Tasks for this day</div>
      <div id="selectedDayTasksList"></div>
    </div>
  </div>

  <!-- ═══ TIMELINE ═══ -->
  <div id="timeline" class="tab-content stack">
    <div class="row-between">
      <div>
        <div style="font-size:18px;font-weight:800">Timeline</div>
        <div style="font-size:12px;color:var(--text3);margin-top:3px">Click a task to mark it complete</div>
      </div>
      <div class="row" style="gap:8px">
        <span style="font-size:12px;color:var(--text3)">Completed</span>
        <span style="font-weight:700;font-family:var(--mono)"><span id="timelineCompleted">0</span>/<span id="tlTotal">16</span></span>
      </div>
    </div>
    <div class="phase-filters" id="phaseFilters">
      <button class="phase-btn active" onclick="filterPhase('all',this)">All</button>
      <button class="phase-btn" onclick="filterPhase('pre',this)">Pre-Release</button>
      <button class="phase-btn" onclick="filterPhase('during',this)">During Release</button>
      <button class="phase-btn" onclick="filterPhase('post',this)">Post-Release</button>
    </div>
    <div class="card card-p">
      <div class="tl-wrap" id="timelineContainer"></div>
    </div>
  </div>

  <!-- ═══ SPOTIFY ═══ -->
  <div id="spotify" class="tab-content stack">
    <div class="row" style="gap:10px">
      <svg width="30" height="30" viewBox="0 0 24 24" fill="#1DB954"><path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/></svg>
      <div><div style="font-size:18px;font-weight:800">Spotify Analytics</div><div style="font-size:12px;color:var(--text3)">Real metrics from Spotify for Artists</div></div>
    </div>
    <div class="spotify-card" style="padding:15px 18px">
      <div style="font-size:12px;font-weight:700;margin-bottom:10px">Artist Profile</div>
      <div class="row" style="gap:10px">
        <input type="text" id="spotifyLinkInput" placeholder="https://open.spotify.com/artist/...">
        <button class="btn btn-green btn-small nowrap" onclick="connectSpotify()">Connect</button>
      </div>
    </div>
    <div class="card card-p" id="spotifySyncPanel">
      <div class="row-between" style="margin-bottom:12px">
        <div>
          <div style="font-size:13px;font-weight:700">Sync Metrics</div>
          <div style="font-size:11px;color:var(--text3);margin-top:3px">Copy exact numbers from <a href="https://artists.spotify.com" target="_blank">Spotify for Artists ↗</a></div>
        </div>
        <button class="btn btn-ghost btn-small hidden" id="spotifyEditBtn" onclick="toggleSpotifyEdit()">Edit</button>
      </div>
      <div id="spotifyForm">
        <div class="info-box" style="margin-bottom:12px">
          <div style="font-size:12px;font-weight:700;color:var(--text);margin-bottom:7px">How to get your metrics:</div>
          <ol>
            <li>Open <strong>Spotify for Artists</strong> → Home</li>
            <li>Copy <strong>Monthly Listeners</strong> from your profile header</li>
            <li>Go to <strong>Audience</strong> → copy Followers</li>
            <li>Go to <strong>Music</strong> → select your release → copy Streams</li>
          </ol>
        </div>
        <div class="grid2" style="gap:10px;margin-bottom:12px">
          <div><label style="font-size:10px;color:var(--text3);text-transform:uppercase;letter-spacing:.08em;display:block;margin-bottom:5px;font-weight:700">Monthly Listeners</label><input type="number" id="inputMonthlyListeners" placeholder="e.g. 1250" min="0"></div>
          <div><label style="font-size:10px;color:var(--text3);text-transform:uppercase;letter-spacing:.08em;display:block;margin-bottom:5px;font-weight:700">Followers</label><input type="number" id="inputFollowers" placeholder="e.g. 450" min="0"></div>
          <div><label style="font-size:10px;color:var(--text3);text-transform:uppercase;letter-spacing:.08em;display:block;margin-bottom:5px;font-weight:700">Streams (28 days)</label><input type="number" id="inputStreams28" placeholder="e.g. 5000" min="0"></div>
          <div><label style="font-size:10px;color:var(--text3);text-transform:uppercase;letter-spacing:.08em;display:block;margin-bottom:5px;font-weight:700">Streams (7 days)</label><input type="number" id="inputStreams7" placeholder="e.g. 1200" min="0"></div>
          <div><label style="font-size:10px;color:var(--text3);text-transform:uppercase;letter-spacing:.08em;display:block;margin-bottom:5px;font-weight:700">Saves (28 days)</label><input type="number" id="inputSaves" placeholder="e.g. 320" min="0"></div>
          <div><label style="font-size:10px;color:var(--text3);text-transform:uppercase;letter-spacing:.08em;display:block;margin-bottom:5px;font-weight:700">Playlist Reach</label><input type="number" id="inputPlaylistReach" placeholder="e.g. 800" min="0"></div>
        </div>
        <div class="row" style="gap:10px">
          <button class="btn btn-green" style="flex:1;justify-content:center" onclick="saveSpotifyStats()">Save Metrics</button>
          <div><label style="font-size:10px;color:var(--text3);display:block;margin-bottom:4px">Capture date</label><input type="date" id="spotifySyncDate" style="width:138px"></div>
        </div>
      </div>
      <div id="spotifyDisplay" class="hidden">
        <div class="spotify-grid" id="spotifyStatsDisplay"></div>
        <div style="font-size:10px;color:var(--text3);text-align:right;margin-top:10px" id="spotifySyncDateDisplay"></div>
      </div>
    </div>
    <div class="spotify-card hidden" id="spotifyEmbed" style="padding:15px 18px">
      <div style="font-size:12px;font-weight:700;margin-bottom:10px">Artist Profile Preview</div>
      <div id="embedContainer"></div>
    </div>
  </div>

  <!-- ═══ SPLIT$ ═══ -->
  <div id="splits" class="tab-content stack">
    <div class="row-between">
      <div><div style="font-size:18px;font-weight:800">SPLIT$</div><div style="font-size:12px;color:var(--text3);margin-top:3px">Rights and royalty distribution</div></div>
      <div class="badge" id="splitsTotalBadge" style="font-size:15px;font-family:var(--mono);padding:5px 12px;border-radius:9px">100%</div>
    </div>
    <div class="card card-p">
      <div class="card-title">Visual Distribution</div>
      <div class="split-bar" id="splitBar"></div>
      <div style="display:flex;flex-wrap:wrap;gap:10px;margin-top:10px" id="splitLegend"></div>
    </div>
    <div class="grid2">
      <div class="card card-p" style="border-color:rgba(109,40,217,.2)">
        <div style="font-size:11px;font-weight:700;color:var(--violet2);margin-bottom:5px">MASTER RIGHTS</div>
        <div style="font-size:12px;color:var(--text2);line-height:1.6">Controls the recording. Generates income from streaming, sync licensing, and media usage.</div>
      </div>
      <div class="card card-p" style="border-color:rgba(190,24,93,.2)">
        <div style="font-size:11px;font-weight:700;color:#f9a8d4;margin-bottom:5px">PUBLISHING</div>
        <div style="font-size:12px;color:var(--text2);line-height:1.6">Controls the composition. Generates performance and mechanical royalties.</div>
      </div>
    </div>
    <div class="card card-p">
      <div class="row-between" style="margin-bottom:10px">
        <div class="card-title" style="margin-bottom:0">Participants</div>
        <div class="row" style="gap:6px">
          <button class="btn btn-ghost btn-small" onclick="addSplit('master')">+ Master</button>
          <button class="btn btn-ghost btn-small" onclick="addSplit('publishing')" style="border-color:rgba(190,24,93,.3);color:#f9a8d4">+ Publishing</button>
        </div>
      </div>
      <div id="splitsList"></div>
    </div>
    <div class="card card-p">
      <div class="card-title">Registration Codes</div>
      <div class="grid2">
        <div><label style="font-size:11px;color:var(--text3);display:block;margin-bottom:5px">ISRC (per track)</label><input type="text" id="isrcCode" placeholder="US-S1Z-24-00001"></div>
        <div><label style="font-size:11px;color:var(--text3);display:block;margin-bottom:5px">UPC (album/EP)</label><input type="text" id="upcCode" placeholder="123456789012"></div>
        <div><label style="font-size:11px;color:var(--text3);display:block;margin-bottom:5px">Registered PRO</label>
          <select id="proSelect"><option value="">Select...</option><option>ASCAP</option><option>BMI</option><option>SESAC</option><option>SGAE</option><option>SAYCO</option><option>SCD</option><option>SOBODAYCOM</option><option>Other</option></select>
        </div>
        <div><label style="font-size:11px;color:var(--text3);display:block;margin-bottom:5px">Work # (PRO)</label><input type="text" id="proWorkId" placeholder="Your PRO registration ID"></div>
      </div>
      <button class="btn btn-ghost" style="margin-top:12px" onclick="saveCodes()">Save Codes</button>
    </div>
  </div>

  <!-- ═══ BUDGET ═══ -->
  <div id="budget" class="tab-content stack">
