// CAMPAIGN STEPS
// ══════════════════════════════════════════════════
window._campaignPhaseFilter = 'all';
function renderCampaignSteps() {
  var p = P(), today = new Date(); today.setHours(0,0,0,0);
  var filter = window._campaignPhaseFilter || 'all';
  var steps = filter === 'all' ? CAMPAIGN_STEPS : CAMPAIGN_STEPS.filter(function(s){ return s.phase === filter; });

  document.getElementById('campaignCompleted').textContent = p.completedTasks.length;
  document.getElementById('campaignTotal').textContent = CAMPAIGN_STEPS.length;

  // Group by phase in order
  var phaseOrder = ['pre','during','post'];
  var groups = {};
  steps.forEach(function(s){ if(!groups[s.phase]) groups[s.phase]=[]; groups[s.phase].push(s); });

  var html = '';
  phaseOrder.forEach(function(phase) {
    if (!groups[phase]) return;
    var phaseSteps = groups[phase];
    var pc = PHASE_COLORS[phase];
    var phaseCompleted = phaseSteps.filter(function(s){ return p.completedTasks.includes(s.num-1); }).length;
    var phasePct = phaseSteps.length ? Math.round(phaseCompleted/phaseSteps.length*100) : 0;
    html += '<div class="card" style="overflow:hidden">' +
      '<div style="padding:12px 16px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:10px;background:rgba(15,15,26,.5)">' +
        '<div style="width:9px;height:9px;border-radius:50%;background:' + pc.hex + ';flex-shrink:0"></div>' +
        '<div style="font-weight:700;font-size:13px">' + pc.label + '</div>' +
        '<div style="margin-left:auto;font-size:11px;color:var(--text3);font-family:var(--mono)">' + phaseCompleted + '/' + phaseSteps.length + '</div>' +
        '<div style="width:80px;height:3px;background:var(--border);border-radius:3px;overflow:hidden"><div style="height:100%;width:' + phasePct + '%;background:' + pc.hex + ';border-radius:3px;transition:width .4s"></div></div>' +
      '</div>' +
      '<div style="padding:10px 12px;display:flex;flex-direction:column;gap:6px">';

    phaseSteps.forEach(function(s) {
      var done = p.completedTasks.includes(s.num-1);
      var date = getTaskDate(s.num);
      var isOverdue = !done && date < today;
      var isToday   = isSameDay(date, today);
      var cc = CAT_COLORS[s.cat] || CAT_COLORS.STRATEGY;
      var borderColor = isOverdue ? 'rgba(239,68,68,.25)' : done ? 'rgba(16,185,129,.15)' : 'var(--border)';
      var bgColor     = isOverdue ? 'rgba(239,68,68,.03)' : done ? 'rgba(16,185,129,.02)' : 'transparent';

      html += '<div onclick="toggleTask(' + (s.num-1) + ')" style="display:flex;gap:12px;padding:12px 13px;border-radius:var(--r);border:1px solid ' + borderColor + ';background:' + bgColor + ';cursor:pointer;transition:background .15s">' +
        '<div style="flex-shrink:0;width:24px;height:24px;border-radius:7px;border:2px solid ' + (done ? 'var(--violet)' : 'var(--border2)') + ';background:' + (done ? 'var(--violet)' : 'transparent') + ';display:flex;align-items:center;justify-content:center;margin-top:1px">';

      if (done) {
        html += '<svg width="10" height="10" viewBox="0 0 12 12" fill="none"><path d="M2 6l3 3 5-5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
      } else {
        html += '<span style="font-size:10px;color:var(--text3);font-family:var(--mono);font-weight:700">' + s.num + '</span>';
      }

      html += '</div>' +
        '<div style="flex:1;min-width:0">' +
          '<div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin-bottom:5px">' +
            '<span class="tag ' + cc.cls + '">' + s.cat + '</span>' +
            (s.critical ? '<span class="tag cat-crit">Critical</span>' : '') +
            '<span style="font-size:10px;color:var(--text3);font-family:var(--mono)">' + s.timing + '</span>' +
            (isOverdue ? '<span style="font-size:10px;color:#fca5a5;font-weight:600">⚠ Overdue</span>' : '') +
            (isToday && !done ? '<span style="font-size:10px;color:#fcd34d;font-weight:600">Today</span>' : '') +
            (done ? '<span style="font-size:10px;color:#6ee7b7;font-weight:600;margin-left:auto">Done ✓</span>' : '') +
          '</div>' +
          '<div style="font-size:13px;font-weight:600;' + (done ? 'text-decoration:line-through;color:var(--text3)' : '') + '">' + escHtml(s.title) + '</div>' +
          '<div class="step-desc">' + escHtml(s.desc) + '</div>' +
        '</div>' +
      '</div>';
    });

    html += '</div></div>';
  });

  document.getElementById('campaignStepsContainer').innerHTML = html;
}
