function getTaskDate(stepNum) {
  var p = P(), idx = stepNum - 1;
  if (p.taskDateOverrides[idx] !== undefined) return new Date(p.taskDateOverrides[idx]);
  var r = new Date(p.releaseDate);
  r.setDate(r.getDate() + (STEP_WEEK[stepNum] || 0) * 7);
  return r;
}
function isSameDay(a,b) { return a.getDate()===b.getDate()&&a.getMonth()===b.getMonth()&&a.getFullYear()===b.getFullYear(); }
function fmtDate(d) { return d.getDate() + ' ' + MONTHS[d.getMonth()].slice(0,3); }
function fmtFull(d) { return DAYS_SHORT[d.getDay()] + ' ' + d.getDate() + ' ' + MONTHS[d.getMonth()]; }
function fmt(n)  { n=n||0; return n>=1e6?(n/1e6).toFixed(1)+'M':n>=1000?(n/1000).toFixed(1)+'K':String(n); }
function fmtN(n) { n=n||0; return n>=1e6?(n/1e6).toFixed(1)+'M':n>=1000?(n/1000).toFixed(1)+'K':n.toLocaleString(); }
function daysUntil() {
  var r=new Date(P().releaseDate), t=new Date(); t.setHours(0,0,0,0); r.setHours(0,0,0,0);
  return Math.ceil((r-t)/864e5);
}

