          <div style="font-size:10px;color:var(--text3);margin-bottom:4px">Asignado</div>
          <div style="display:flex;align-items:center;gap:3px"><span style="color:var(--text3);font-size:12px">$</span>
            <input class="budget-num" type="number" min="0" value="${item.allocated}" onchange="updateBudget(${i},'allocated',+this.value)">
          </div>
        </div>
        <div>
          <div style="font-size:10px;color:var(--text3);margin-bottom:4px">Gastado</div>
          <div style="display:flex;align-items:center;gap:3px"><span style="color:var(--text3);font-size:12px">$</span>
            <input class="budget-num" type="number" min="0" value="${item.spent}" onchange="updateBudget(${i},'spent',+this.value)" style="color:var(--text3)">
