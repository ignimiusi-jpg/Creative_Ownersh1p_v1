// FULL RENDER
// ════════════════════════════════════════════════════
function renderAll() {
  renderProjectSwitcher();
  renderHeader();
  renderCommandStats();
  renderUpcoming();
  renderSpotifyWidget();
  renderCalendar();
  renderTimeline();
  renderSplits();
  renderBudget();
  renderOutreach();
  renderSocialAudit();
}

// ════════════════════════════════════════════════════
// TAB SWITCHING
// ════════════════════════════════════════════════════
function switchTab(id) {
  document.querySelectorAll('.tab-content').forEach(t=>t.classList.remove('active'));
  document.querySelectorAll('.nav-item').forEach(b=>b.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  document.querySelectorAll('.nav-item').forEach(b=>{
    if(b.getAttribute('onclick')===`switchTab('${id}')`) b.classList.add('active');
  });
  if(id==='calendar') renderCalendar();
  if(id==='timeline') renderTimeline();
}

function switchInnerTab(id, btn) {
  document.querySelectorAll('.inner-tab-content').forEach(t=>t.classList.remove('active'));
  document.querySelectorAll('.inner-tab').forEach(b=>b.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  btn.classList.add('active');
}

function exportData() {
  const b=new Blob([JSON.stringify(app,null,2)],{type:'application/json'});
  const a=document.createElement('a'); a.href=URL.createObjectURL(b);
  a.download=`creative-ownership-${P().name.replace(/\s+/g,'-')}.json`; a.click();
}

// ════════════════════════════════════════════════════
// SOCIAL AUDIT
// ════════════════════════════════════════════════════
function getSocial() { return P().social; }
function getSocialPlatformData() { return P().social[P().social.platform]; }

function setSocialPlatform(platform, silent) {
  if (!P().social) return;
  P().social.platform = platform;
  if (!silent) saveApp();

  // Toggle button styles
  const btnTT = document.getElementById('btn-tiktok');
  const btnIG = document.getElementById('btn-instagram');
  btnTT.classList.toggle('active', platform === 'tiktok');
  btnIG.classList.toggle('active', platform === 'instagram');

  // Show/hide fields
  document.getElementById('tiktokFields').style.display    = platform === 'tiktok'    ? '' : 'none';
  document.getElementById('instagramFields').style.display = platform === 'instagram' ? '' : 'none';

  // Load handle/url for this platform
  const pd = P().social[platform];
  document.getElementById('socialHandle').value = pd.handle || '';
  document.getElementById('socialUrl').value    = pd.url    || '';

  // Set default audit date
  if (!document.getElementById('auditDate').value)
    document.getElementById('auditDate').value = new Date().toISOString().split('T')[0];

  renderSocialAudit();
}

function saveSocialProfile() {
  const pd = getSocialPlatformData();
  pd.handle = document.getElementById('socialHandle').value.trim();
  pd.url    = document.getElementById('socialUrl').value.trim();
  saveApp();
}

function saveAuditSnapshot() {
  const platform = P().social.platform;
  const date = document.getElementById('auditDate').value || new Date().toISOString().split('T')[0];
  let entry = { date, ts: Date.now() };

  if (platform === 'tiktok') {
    entry.followers   = +document.getElementById('tt_followers').value  || 0;
    entry.following   = +document.getElementById('tt_following').value  || 0;
    entry.totalLikes  = +document.getElementById('tt_totalLikes').value || 0;
    entry.avgViews    = +document.getElementById('tt_avgViews').value   || 0;
    entry.avgLikes    = +document.getElementById('tt_avgLikes').value   || 0;
    entry.avgComments = +document.getElementById('tt_avgComments').value|| 0;
    entry.avgShares   = +document.getElementById('tt_avgShares').value  || 0;
    entry.notes       = document.getElementById('tt_notes').value.trim();
    // Engagement = (likes + comments + shares) / views * 100
    entry.engRate = entry.avgViews > 0
      ? +((entry.avgLikes + entry.avgComments + entry.avgShares) / entry.avgViews * 100).toFixed(2)
      : 0;
  } else {
    entry.followers   = +document.getElementById('ig_followers').value  || 0;
    entry.following   = +document.getElementById('ig_following').value  || 0;
    entry.posts       = +document.getElementById('ig_posts').value      || 0;
    entry.avgLikes    = +document.getElementById('ig_avgLikes').value   || 0;
    entry.avgComments = +document.getElementById('ig_avgComments').value|| 0;
    entry.avgReach    = +document.getElementById('ig_avgReach').value   || 0;
    entry.avgSaves    = +document.getElementById('ig_avgSaves').value   || 0;
    entry.notes       = document.getElementById('ig_notes').value.trim();
    // Engagement = (likes + comments + saves) / followers * 100
    entry.engRate = entry.followers > 0
      ? +((entry.avgLikes + entry.avgComments + entry.avgSaves) / entry.followers * 100).toFixed(2)
      : 0;
  }

  if (!entry.followers) { alert('Ingresa al menos el número de seguidores.'); return; }

  const pd = getSocialPlatformData();
  pd.audits.push(entry);
  pd.audits.sort((a,b) => new Date(a.date) - new Date(b.date));
  saveApp();

  // Clear form
  ['tt_followers','tt_following','tt_totalLikes','tt_avgViews','tt_avgLikes','tt_avgComments','tt_avgShares','tt_notes',
   'ig_followers','ig_following','ig_posts','ig_avgLikes','ig_avgComments','ig_avgReach','ig_avgSaves','ig_notes']
   .forEach(id => { const el=document.getElementById(id); if(el) el.value=''; });

  renderSocialAudit();
}

function deleteAudit(idx) {
  if (!confirm('¿Eliminar esta auditoría?')) return;
  getSocialPlatformData().audits.splice(idx,1);
  saveApp(); renderSocialAudit();
}

function renderSocialAudit() {
  const platform = P().social ? P().social.platform : 'tiktok';
  const pd = getSocialPlatformData();
  if (!pd) return;
  const audits = pd.audits || [];
  const latest = audits.length ? audits[audits.length - 1] : null;

  // ── Current stats ──
  const statsGrid = document.getElementById('socialStatsGrid');
  const statsWrap = document.getElementById('socialCurrentStats');
  const healthPanel = document.getElementById('socialHealthPanel');

  if (latest) {
    statsWrap.classList.remove('hidden');
    healthPanel.style.display = 'grid';

    const prevEntry = audits.length > 1 ? audits[audits.length - 2] : null;
    const followerDelta = prevEntry ? latest.followers - prevEntry.followers : null;
    const engDelta      = prevEntry ? +(latest.engRate - prevEntry.engRate).toFixed(2) : null;

    const deltaHTML = (val, suffix='') => val === null ? '' :
      `<div style="font-size:11px;color:${val>=0?'#6ee7b7':'#fca5a5'};margin-top:3px">${val>=0?'↑':'↓'} ${Math.abs(val).toLocaleString()}${suffix} vs anterior</div>`;

    if (platform === 'tiktok') {
      statsGrid.innerHTML = `
        <div class="audit-stat tiktok-grad">
          <div class="audit-stat-label">👥 Seguidores</div>
          <div class="audit-stat-val">${fmtN(latest.followers)}</div>
          ${deltaHTML(followerDelta)}
        </div>
        <div class="audit-stat tiktok-grad">
          <div class="audit-stat-label">▶ Prom. Vistas</div>
          <div class="audit-stat-val">${fmtN(latest.avgViews)}</div>
          <div class="audit-stat-sub">por video</div>
        </div>
        <div class="audit-stat tiktok-grad">
          <div class="audit-stat-label">❤ Prom. Likes</div>
          <div class="audit-stat-val">${fmtN(latest.avgLikes)}</div>
          <div class="audit-stat-sub">por video</div>
        </div>
        <div class="audit-stat tiktok-grad" style="border-color:rgba(255,255,255,.12)">
          <div class="audit-stat-label">⚡ Engagement</div>
          <div class="audit-stat-val" style="color:${engColor(latest.engRate)}">${latest.engRate}%</div>
          ${deltaHTML(engDelta,'%')}
        </div>
        <div class="audit-stat tiktok-grad">
          <div class="audit-stat-label">💬 Prom. Comentarios</div>
          <div class="audit-stat-val">${fmtN(latest.avgComments)}</div>
        </div>
        <div class="audit-stat tiktok-grad">
          <div class="audit-stat-label">🔗 Prom. Shares</div>
          <div class="audit-stat-val">${fmtN(latest.avgShares)}</div>
        </div>
        <div class="audit-stat tiktok-grad">
          <div class="audit-stat-label">❤ Total Likes Perfil</div>
          <div class="audit-stat-val">${fmtN(latest.totalLikes)}</div>
        </div>
        <div class="audit-stat tiktok-grad">
          <div class="audit-stat-label">📅 Capturado</div>
          <div class="audit-stat-val" style="font-size:14px">${latest.date}</div>
          <div class="audit-stat-sub">${audits.length} auditoría${audits.length!==1?'s':''}</div>
        </div>`;
    } else {
      statsGrid.innerHTML = `
        <div class="audit-stat ig-grad">
          <div class="audit-stat-label">👥 Seguidores</div>
          <div class="audit-stat-val">${fmtN(latest.followers)}</div>
          ${deltaHTML(followerDelta)}
        </div>
        <div class="audit-stat ig-grad">
          <div class="audit-stat-label">❤ Prom. Likes</div>
          <div class="audit-stat-val">${fmtN(latest.avgLikes)}</div>
          <div class="audit-stat-sub">por post</div>
        </div>
        <div class="audit-stat ig-grad">
          <div class="audit-stat-label">👁 Prom. Reach</div>
          <div class="audit-stat-val">${fmtN(latest.avgReach)}</div>
          <div class="audit-stat-sub">por post</div>
        </div>
        <div class="audit-stat ig-grad" style="border-color:rgba(188,24,136,.3)">
          <div class="audit-stat-label">⚡ Engagement</div>
          <div class="audit-stat-val" style="color:${engColor(latest.engRate)}">${latest.engRate}%</div>
          ${deltaHTML(engDelta,'%')}
        </div>
        <div class="audit-stat ig-grad">
          <div class="audit-stat-label">💬 Prom. Comentarios</div>
          <div class="audit-stat-val">${fmtN(latest.avgComments)}</div>
        </div>
        <div class="audit-stat ig-grad">
          <div class="audit-stat-label">🔖 Prom. Saves</div>
          <div class="audit-stat-val">${fmtN(latest.avgSaves)}</div>
        </div>
        <div class="audit-stat ig-grad">
          <div class="audit-stat-label">📝 Posts Totales</div>
          <div class="audit-stat-val">${fmtN(latest.posts)}</div>
        </div>
        <div class="audit-stat ig-grad">
          <div class="audit-stat-label">📅 Capturado</div>
          <div class="audit-stat-val" style="font-size:14px">${latest.date}</div>
          <div class="audit-stat-sub">${audits.length} auditoría${audits.length!==1?'s':''}</div>
        </div>`;
    }

    // ── Engagement score ring ──
    const eng = latest.engRate;
    const maxEng = platform === 'tiktok' ? 15 : 8;
    const pct = Math.min(100, eng / maxEng * 100);
    const circ = 188.5;
    const offset = circ - (pct / 100) * circ;
    const arc = document.getElementById('engScoreArc');
    const engTxt = document.getElementById('engScoreText');
    const label  = document.getElementById('engScoreLabel');
    const desc   = document.getElementById('engScoreDesc');
    arc.style.strokeDashoffset = offset;
    arc.style.stroke = engColor(eng, platform);
    engTxt.textContent = eng + '%';
    engTxt.style.fill = engColor(eng, platform);

    const tier = engTier(eng, platform);
    label.textContent = tier.label;
    label.style.color = tier.color;
    desc.textContent  = tier.desc;

    // ── Benchmarks ──
    const bmarks = platform === 'tiktok' ? [
      { tier:'Micro (<10K)',   eng:'5–15%',   followers:'<10,000'  },
      { tier:'Mid (10K–100K)',  eng:'3–8%',    followers:'10–100K'  },
      { tier:'Macro (100K+)',   eng:'1–5%',    followers:'100K+'    },
    ] : [
      { tier:'Micro (<10K)',   eng:'4–8%',    followers:'<10,000'  },
      { tier:'Mid (10K–100K)',  eng:'2–5%',    followers:'10–100K'  },
      { tier:'Macro (100K+)',   eng:'1–3%',    followers:'100K+'    },
    ];
    const yourTier = latest.followers < 10000 ? 0 : latest.followers < 100000 ? 1 : 2;
    document.getElementById('benchmarkList').innerHTML = bmarks.map((b,i) => `
      <div class="benchmark-row">
        <div>
          <div style="font-size:12px;font-weight:${i===yourTier?'700':'500'};color:${i===yourTier?'var(--text)':'var(--text3)'}">${b.tier} ${i===yourTier?'← tú':''}</div>
          <div style="font-size:10px;color:var(--text3)">${b.followers}</div>
        </div>
        <div style="text-align:right">
          <div style="font-size:12px;font-family:var(--mono);color:${i===yourTier?engColor(eng,platform):'var(--text3)'}">Eng: ${b.eng}</div>
          ${i===yourTier?`<div style="font-size:10px;color:${engColor(eng,platform)}">Tuyo: ${eng}%</div>`:''}
        </div>
      </div>`).join('');
  } else {
    statsWrap.classList.add('hidden');
    healthPanel.style.display = 'none';
  }

  // ── History table ──
  const histEmpty  = document.getElementById('socialHistoryEmpty');
  const histTable  = document.getElementById('socialHistoryTable');
  const countLabel = document.getElementById('socialAuditCount');

  countLabel.textContent = `${audits.length} entrada${audits.length!==1?'s':''}`;

  if (!audits.length) {
    histEmpty.style.display = '';
    histTable.classList.add('hidden');
    document.getElementById('socialChartCard').classList.add('hidden');
    return;
  }

  histEmpty.style.display = 'none';
  histTable.classList.remove('hidden');

  const cols = platform === 'tiktok'
    ? ['Fecha','Seguidores','Vistas Prom.','Likes Prom.','Engagement','Notas','']
    : ['Fecha','Seguidores','Likes Prom.','Reach Prom.','Engagement','Notas',''];

  let tHTML = `<table class="audit-history-table"><thead><tr>${cols.map(c=>`<th>${c}</th>`).join('')}</tr></thead><tbody>`;
  [...audits].reverse().forEach((a, ri) => {
    const realIdx = audits.length - 1 - ri;
    const engCls = a.engRate >= (platform==='tiktok'?5:4) ? 'eng-great' : a.engRate >= (platform==='tiktok'?2:1.5) ? 'eng-good' : 'eng-low';
    if (platform === 'tiktok') {
      tHTML += `<tr>
        <td style="font-family:var(--mono);font-size:11px;color:var(--text3)">${a.date}</td>
        <td style="font-weight:700">${fmtN(a.followers)}</td>
        <td>${fmtN(a.avgViews)}</td>
        <td>${fmtN(a.avgLikes)}</td>
        <td><span class="eng-chip ${engCls}">${a.engRate}%</span></td>
        <td style="color:var(--text3);font-size:11px;max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${a.notes||'—'}</td>
        <td><button onclick="deleteAudit(${realIdx})" style="background:none;border:none;cursor:pointer;color:var(--text3);font-size:12px" onmouseover="this.style.color='#fca5a5'" onmouseout="this.style.color='var(--text3)'">✕</button></td>
      </tr>`;
    } else {
      tHTML += `<tr>
        <td style="font-family:var(--mono);font-size:11px;color:var(--text3)">${a.date}</td>
        <td style="font-weight:700">${fmtN(a.followers)}</td>
        <td>${fmtN(a.avgLikes)}</td>
        <td>${fmtN(a.avgReach)}</td>
        <td><span class="eng-chip ${engCls}">${a.engRate}%</span></td>
        <td style="color:var(--text3);font-size:11px;max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${a.notes||'—'}</td>
        <td><button onclick="deleteAudit(${realIdx})" style="background:none;border:none;cursor:pointer;color:var(--text3);font-size:12px" onmouseover="this.style.color='#fca5a5'" onmouseout="this.style.color='var(--text3)'">✕</button></td>
      </tr>`;
    }
  });
  tHTML += '</tbody></table>';
  histTable.innerHTML = tHTML;

  // ── Growth Chart ──
  if (audits.length >= 2) {
    document.getElementById('socialChartCard').classList.remove('hidden');
    drawGrowthChart(audits);
  } else {
    document.getElementById('socialChartCard').classList.add('hidden');
  }
}

function fmtN(n) { n=n||0; return n>=1e6?(n/1e6).toFixed(1)+'M':n>=1000?(n/1000).toFixed(1)+'K':n.toLocaleString(); }

function engColor(eng, platform) {
  const hi = platform==='instagram' ? 4 : 5;
  const mid = platform==='instagram' ? 1.5 : 2;
  return eng >= hi ? '#6ee7b7' : eng >= mid ? '#fcd34d' : '#fca5a5';
}

function engTier(eng, platform) {
  if (platform === 'tiktok') {
    if (eng >= 8)  return { label:'🔥 Viral',      color:'#fcd34d', desc:'Engagement excepcional. Tu contenido resuena fuerte. Momento de escalar con ads.' };
    if (eng >= 4)  return { label:'✅ Sólido',      color:'#6ee7b7', desc:'Buen engagement. El algoritmo te favorece. Consistencia es clave.' };
    if (eng >= 1.5)return { label:'📈 En crecimiento', color:'#93c5fd', desc:'Engagement promedio. Experimenta con formatos y horarios de publicación.' };
    return          { label:'⚠ Bajo',             color:'#fca5a5', desc:'Necesita atención. Analiza qué contenido generó más interacción.' };
  } else {
    if (eng >= 5)  return { label:'🔥 Excepcional',  color:'#fcd34d', desc:'Engagement muy alto. Tu audiencia está muy comprometida.' };
    if (eng >= 2.5)return { label:'✅ Bueno',         color:'#6ee7b7', desc:'Por encima del promedio. Sigue con el contenido que funciona.' };
    if (eng >= 1)  return { label:'📈 Promedio',      color:'#93c5fd', desc:'Dentro del rango normal para tu tier. Prueba más Reels.' };
    return          { label:'⚠ Bajo',              color:'#fca5a5', desc:'Debajo del promedio. Considera publicar más consistentemente.' };
  }
}

function drawGrowthChart(audits) {
  const canvas = document.getElementById('growthChart');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const W = canvas.offsetWidth || 600;
  canvas.width = W; canvas.height = 140;
  ctx.clearRect(0,0,W,140);

  const followers = audits.map(a => a.followers);
  const dates     = audits.map(a => a.date.slice(5)); // MM-DD
  const minF = Math.min(...followers), maxF = Math.max(...followers);
  const range = maxF - minF || 1;
  const pad = { t:16, b:28, l:10, r:10 };
  const cW = W - pad.l - pad.r, cH = 140 - pad.t - pad.b;
  const step = cW / (followers.length - 1);

  const pts = followers.map((f,i) => ({
    x: pad.l + i * step,
    y: pad.t + cH - ((f - minF) / range) * cH
  }));

  // Gradient fill
  const grad = ctx.createLinearGradient(0, pad.t, 0, pad.t + cH);
  grad.addColorStop(0, 'rgba(124,58,237,.35)');
  grad.addColorStop(1, 'rgba(124,58,237,.02)');
  ctx.beginPath();
  ctx.moveTo(pts[0].x, pts[0].y);
  pts.slice(1).forEach(p => ctx.lineTo(p.x, p.y));
  ctx.lineTo(pts[pts.length-1].x, pad.t + cH);
  ctx.lineTo(pts[0].x, pad.t + cH);
  ctx.closePath();
  ctx.fillStyle = grad;
  ctx.fill();

  // Line
  ctx.beginPath();
  ctx.moveTo(pts[0].x, pts[0].y);
  pts.slice(1).forEach(p => ctx.lineTo(p.x, p.y));
  ctx.strokeStyle = '#7c3aed';
  ctx.lineWidth = 2.5;
  ctx.lineJoin = 'round';
  ctx.stroke();

  // Dots + labels
  ctx.font = '10px JetBrains Mono, monospace';
  ctx.textAlign = 'center';
  pts.forEach((p,i) => {
    ctx.beginPath();
    ctx.arc(p.x, p.y, 4, 0, Math.PI*2);
    ctx.fillStyle = i === pts.length-1 ? '#a78bfa' : '#7c3aed';
    ctx.fill();
    // Date label
    ctx.fillStyle = 'rgba(136,136,168,.7)';
    ctx.fillText(dates[i], p.x, 140 - 6);
    // Value on last point
    if (i === pts.length - 1) {
      ctx.fillStyle = '#a78bfa';
      ctx.fillText(fmtN(followers[i]), p.x, p.y - 10);
    }
  });
}

document.addEventListener('DOMContentLoaded', () => {
  loadApp();
  loadProjectIntoUI();
  renderAll();

  document.getElementById('projectName').addEventListener('change', e => {
    P().name = e.target.value; saveApp(); renderProjectSwitcher(); document.getElementById('activeProjectLabel').textContent = P().name;
  });
  document.getElementById('releaseDate').addEventListener('change', e => {
    P().releaseDate = e.target.value; saveApp(); renderAll();
  });
  document.getElementById('secretInput').addEventListener('change', e => {
    P().secret = e.target.value; saveApp();
  });

  // Set default sync date
  if (!document.getElementById('spotifySyncDate').value)
    document.getElementById('spotifySyncDate').value = new Date().toISOString().split('T')[0];
});
