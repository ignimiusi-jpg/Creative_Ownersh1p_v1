const DAYS_SHORT = ['Dom','Lun','Mar','Mié','Jue','Vie','Sáb'];
const PROJECT_COLORS = ['#7c3aed','#0891b2','#059669','#db2777','#d97706','#6366f1','#f43f5e','#9333ea'];

// ════════════════════════════════════════════════════
// APP STATE (multi-project)
// ════════════════════════════════════════════════════
let app = {
  currentProjectId: null,
  projects: {},
  globalAI: { apiKey: '' }
};

function newProjectData(name, releaseDate, genre) {
  const id = 'proj_' + Date.now();
  return {
    id, name: name || 'Nuevo Release',
    color: PROJECT_COLORS[Object.keys(app.projects).length % PROJECT_COLORS.length],
    releaseDate: releaseDate || new Date(Date.now()+30*24*60*60*1000).toISOString().split('T')[0],
    secret: '',
    completedTasks: [],
    taskDateOverrides: {},
    splits: [{ id:1, name:'Artista Principal', role:'Master + Publishing', type:'both', percentage:100 }],
    codes: { isrc:'', upc:'', pro:'', proWorkId:'' },
    budget: { total:500, items:[
      { id:1, category:'Distribución', allocated:30, spent:25 },
      { id:2, category:'Visuales',     allocated:150, spent:80 },
      { id:3, category:'Ads',          allocated:200, spent:0  },
      { id:4, category:'PR',           allocated:100, spent:50 }
    ]},
    playlists: [
      { id:1, name:'Lo-Fi Beats',   reach:'5M+',  pitchDate:'', status:'not-started' },
      { id:2, name:'Chill Vibes',   reach:'3M+',  pitchDate:'', status:'pitched'     },
      { id:3, name:'Fresh Finds',   reach:'800K', pitchDate:'', status:'not-started' },
      { id:4, name:'The Cozy Chill',reach:'200K', pitchDate:'', status:'accepted'    }
    ],
    spotify: { connected:false, artistId:'', locked:false, syncDate:'',
      monthlyListeners:0, followers:0, streams28:0, streams7:0, saves:0, playlistReach:0 },
    ai: { genre: genre||'', mood:'', audience:'', platforms:'', chatHistory:[] },
    social: {
      platform: 'tiktok',
      tiktok:    { handle:'', url:'', audits:[] },
      instagram: { handle:'', url:'', audits:[] }
    }
  };
}

function P() { return app.projects[app.currentProjectId]; }

// ════════════════════════════════════════════════════
// PERSISTENCE
// ════════════════════════════════════════════════════
function saveApp() { localStorage.setItem('co_v6', JSON.stringify(app)); }
function loadApp() {
  const raw = localStorage.getItem('co_v6');
  if (raw) {
    try { Object.assign(app, JSON.parse(raw)); } catch(e) {}
  }
  if (!app.projects || !Object.keys(app.projects).length) {
    const p = newProjectData('Mi Primer Release');
    app.projects[p.id] = p;
    app.currentProjectId = p.id;
  }
  if (!app.currentProjectId || !app.projects[app.currentProjectId]) {
    app.currentProjectId = Object.keys(app.projects)[0];
  }
  if (!app.globalAI) app.globalAI = { apiKey:'' };
  // Migrate old single-project data
  Object.values(app.projects).forEach(p => {
    if (!p.taskDateOverrides) p.taskDateOverrides = {};
    if (!p.codes) p.codes = { isrc:'', upc:'', pro:'', proWorkId:'' };
    if (!p.social) p.social = { platform:'tiktok', tiktok:{handle:'',url:'',audits:[]}, instagram:{handle:'',url:'',audits:[]} };
    if (!p.social.tiktok) p.social.tiktok = {handle:'',url:'',audits:[]};
    if (!p.social.instagram) p.social.instagram = {handle:'',url:'',audits:[]};
  });
}

// ════════════════════════════════════════════════════
// PROJECT SWITCHER UI
// ════════════════════════════════════════════════════
function renderProjectSwitcher() {
  const p = P();
  document.getElementById('activeProjectDot').style.background = p.color;
  document.getElementById('activeProjectLabel').textContent = p.name;

  let html = '';
  Object.values(app.projects).forEach(proj => {
    html += `<div class="project-menu-item ${proj.id===app.currentProjectId?'active':''}" onclick="switchProject('${proj.id}')">
      <div class="project-dot" style="background:${proj.color}"></div>
      <span style="flex:1;font-size:12px">${proj.name}</span>
      <span style="font-size:10px;color:var(--text3)">${countdown(proj.releaseDate)}</span>
      ${Object.keys(app.projects).length>1?`<button class="del-btn" onclick="event.stopPropagation();deleteProject('${proj.id}')">✕</button>`:''}
    </div>`;
  });
  document.getElementById('projectMenuItems').innerHTML = html;
}

function countdown(dateStr) {
  const d = Math.ceil((new Date(dateStr) - new Date()) / (1000*60*60*24));
  if (isNaN(d)) return '';
  return d > 0 ? d+'d' : d === 0 ? '🚀' : `+${Math.abs(d)}d`;
}

function toggleProjectMenu() {
  document.getElementById('projectMenu').classList.toggle('open');
}

document.addEventListener('click', e => {
  const dd = document.getElementById('projectDropdown');
  if (dd && !dd.contains(e.target)) document.getElementById('projectMenu').classList.remove('open');
});

function switchProject(id) {
  app.currentProjectId = id;
  saveApp();
  document.getElementById('projectMenu').classList.remove('open');
  loadProjectIntoUI();
  renderAll();
  // Reset phase filter
  document.querySelectorAll('.phase-btn').forEach(b => b.classList.remove('active'));
  document.querySelector('.phase-btn').classList.add('active');
  app.phaseFilter = 'all';
}

function deleteProject(id) {
  if (Object.keys(app.projects).length <= 1) { alert('Necesitas al menos un release.'); return; }
  if (!confirm('¿Eliminar este release? Esta acción no se puede deshacer.')) return;
  delete app.projects[id];
  if (app.currentProjectId === id) app.currentProjectId = Object.keys(app.projects)[0];
  saveApp();
  switchProject(app.currentProjectId);
}

// ════════════════════════════════════════════════════
// NEW PROJECT MODAL
// ════════════════════════════════════════════════════
function openNewProjectModal() {
  document.getElementById('projectMenu').classList.remove('open');
  document.getElementById('newProjectModal').classList.add('open');
  const d = new Date(); d.setDate(d.getDate()+30);
  document.getElementById('newProjectDate').value = d.toISOString().split('T')[0];
  document.getElementById('newProjectName').value = '';
  document.getElementById('newProjectGenre').value = '';
  setTimeout(() => document.getElementById('newProjectName').focus(), 100);
}
function closeNewProjectModal() {
  document.getElementById('newProjectModal').classList.remove('open');
}
function createProject() {
  const name = document.getElementById('newProjectName').value.trim();
  if (!name) { document.getElementById('newProjectName').focus(); return; }
  const p = newProjectData(name, document.getElementById('newProjectDate').value, document.getElementById('newProjectGenre').value);
  app.projects[p.id] = p;
  app.currentProjectId = p.id;
  saveApp();
  closeNewProjectModal();
  loadProjectIntoUI();
  renderAll();
}

// ════════════════════════════════════════════════════
// LOAD PROJECT INTO UI FIELDS
// ════════════════════════════════════════════════════
function loadProjectIntoUI() {
  const p = P();
  if (!p) return;
  document.getElementById('projectName').value = p.name;
  document.getElementById('releaseDate').value = p.releaseDate;
  document.getElementById('secretInput').value = p.secret||'';

  // Codes
  document.getElementById('isrcCode').value = p.codes.isrc||'';
  document.getElementById('upcCode').value  = p.codes.upc||'';
  document.getElementById('proSelect').value = p.codes.pro||'';
  document.getElementById('proWorkId').value = p.codes.proWorkId||'';

  // Spotify
  const sp = p.spotify;
  document.getElementById('spotifyLinkInput').value = sp.artistId ? `https://open.spotify.com/artist/${sp.artistId}` : '';
  document.getElementById('inputMonthlyListeners').value = sp.monthlyListeners||'';
  document.getElementById('inputFollowers').value = sp.followers||'';
  document.getElementById('inputStreams28').value = sp.streams28||'';
  document.getElementById('inputStreams7').value  = sp.streams7||'';
  document.getElementById('inputSaves').value     = sp.saves||'';
  document.getElementById('inputPlaylistReach').value = sp.playlistReach||'';
  document.getElementById('spotifySyncDate').value = sp.syncDate || new Date().toISOString().split('T')[0];

  // Spotify display/form toggle
  if (sp.locked && sp.monthlyListeners > 0) {
    document.getElementById('spotifyForm').classList.add('hidden');
    document.getElementById('spotifyDisplay').classList.remove('hidden');
    document.getElementById('spotifyEditBtn').classList.remove('hidden');
    renderSpotifyDisplay();
  } else {
    document.getElementById('spotifyForm').classList.remove('hidden');
    document.getElementById('spotifyDisplay').classList.add('hidden');
    document.getElementById('spotifyEditBtn').classList.add('hidden');
  }

  // Spotify embed
  if (sp.connected && sp.artistId) {
    document.getElementById('spotifyEmbed').classList.remove('hidden');
    document.getElementById('embedContainer').innerHTML = `<iframe style="border-radius:10px" src="https://open.spotify.com/embed/artist/${sp.artistId}?utm_source=generator&theme=0" width="100%" height="260" frameBorder="0" allowfullscreen="" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="lazy"></iframe>`;
  } else {
    document.getElementById('spotifyEmbed').classList.add('hidden');
  }

  // AI context
  const ai = p.ai;
  document.getElementById('aiGenre').value = ai.genre||'';
  document.getElementById('aiMood').value = ai.mood||'';
  document.getElementById('aiAudience').value = ai.audience||'';
  document.getElementById('aiPlatforms').value = ai.platforms||'';

  // API key
  if (app.globalAI.apiKey) {
    document.getElementById('apiKeyInput').value = app.globalAI.apiKey;
    renderApiKeyConnected();
  }

  // Budget total input
  document.getElementById('budgetTotalInput').value = p.budget.total;

  // Social
  if (p.social) {
    setSocialPlatform(p.social.platform || 'tiktok', true);
    const tt = p.social.tiktok, ig = p.social.instagram;
    document.getElementById('socialHandle').value = (p.social.platform === 'instagram' ? ig.handle : tt.handle) || '';
    document.getElementById('socialUrl').value = (p.social.platform === 'instagram' ? ig.url : tt.url) || '';
  }
}

// ════════════════════════════════════════════════════
// DATE UTILS
// ════════════════════════════════════════════════════
function getTaskDate(task, idx) {
  const p = P();
  if (p.taskDateOverrides[idx] !== undefined) return new Date(p.taskDateOverrides[idx]);
  const r = new Date(p.releaseDate);
  r.setDate(r.getDate() + task.week * 7);
  return r;
}
function isSameDay(a,b) { return a.getDate()===b.getDate() && a.getMonth()===b.getMonth() && a.getFullYear()===b.getFullYear(); }
function fmtDate(d) { return `${d.getDate()} ${MONTHS[d.getMonth()].slice(0,3)}`; }
function fmtFull(d) { return `${DAYS_SHORT[d.getDay()]} ${d.getDate()} de ${MONTHS[d.getMonth()]}`; }
function fmt(n) { n=n||0; return n>=1e6?(n/1e6).toFixed(1)+'M':n>=1000?(n/1000).toFixed(1)+'K':n.toString(); }
function daysUntil() {
  const r=new Date(P().releaseDate), t=new Date();
  t.setHours(0,0,0,0); r.setHours(0,0,0,0);
  return Math.ceil((r-t)/(864e5));
}

// ════════════════════════════════════════════════════
// CALENDAR
// ════════════════════════════════════════════════════
if (!window._calMonth) window._calMonth = new Date();
let _dragIdx = null;

function renderCalendar() {
  const yr = window._calMonth.getFullYear(), mo = window._calMonth.getMonth();
  document.getElementById('currentMonth').textContent = `${MONTHS[mo]} ${yr}`;

  const first = new Date(yr, mo, 1);
  const start = new Date(first); start.setDate(start.getDate() - first.getDay());
  const today = new Date(); today.setHours(0,0,0,0);
  const release = new Date(P().releaseDate); release.setHours(0,0,0,0);
  const weekAhead = new Date(today); weekAhead.setDate(weekAhead.getDate()+7);

  const tdArr = TASKS.map((t,i) => ({ ...t, i, date:getTaskDate(t,i), done:P().completedTasks.includes(i) }));
  let html='', cur=new Date(start);

  for(let cell=0; cell<42; cell++) {
    const isCurMo = cur.getMonth()===mo;
    const isToday = isSameDay(cur,today);
    const isRelease = isSameDay(cur,release);
    const dayTasks = tdArr.filter(t=>isSameDay(t.date,cur));
    const dateISO = cur.toISOString();
    const dateStr = cur.toISOString().split('T')[0];

    let cls='cal-cell';
    if(!isCurMo) cls+=' other-month';
    if(isToday) cls+=' today';
    if(isRelease) cls+=' release-day';

    html+=`<div class="${cls}" onclick="calSelectDay('${dateISO}')" ondragover="event.preventDefault();this.classList.add('drag-over')" ondragleave="this.classList.remove('drag-over')" ondrop="calDrop(event,'${dateStr}',this)">
      <span class="cal-num${isToday?' today-num':''}${isRelease?' release-num':''}">${cur.getDate()}</span>
      ${isRelease?'<span class="cal-release-label">🚀 RELEASE</span>':''}
      <div class="cal-tasks">`;

    dayTasks.slice(0,3).forEach(t=>{
      const isOvr=!t.done&&t.date<today, isTW=!t.done&&t.date>=today&&t.date<=weekAhead;
      const style = t.done?`background:rgba(16,185,129,.2);color:#6ee7b7`
        : isOvr?`background:rgba(239,68,68,.25);color:#fca5a5`
        : isTW?`background:rgba(245,158,11,.22);color:#fcd34d`
        : `background:${CAT_COLORS[t.category].hex}22;color:${CAT_COLORS[t.category].hex}`;
      html+=`<div class="cal-task${t.done?' done':''}" style="${style}" draggable="true"
        title="${t.task}"
        ondragstart="event.dataTransfer.effectAllowed='move';_dragIdx=${t.i};setTimeout(()=>this.style.opacity='.3',0)"
        ondragend="this.style.opacity='1'"
        onclick="event.stopPropagation();toggleTask(${t.i})">${t.task.slice(0,22)}${t.task.length>22?'…':''}</div>`;
    });
    if(dayTasks.length>3) html+=`<div class="cal-more">+${dayTasks.length-3} más</div>`;

    html+='</div></div>';
    cur.setDate(cur.getDate()+1);
  }
  document.getElementById('calendarGrid').innerHTML=html;
}

function calDrop(ev, dateStr, el) {
  ev.preventDefault(); el.classList.remove('drag-over');
  if (_dragIdx !== null) {
    P().taskDateOverrides[_dragIdx] = dateStr;
    _dragIdx=null; saveApp(); renderAll();
  }
}

function changeMonth(d) { window._calMonth.setMonth(window._calMonth.getMonth()+d); renderCalendar(); }

function calSelectDay(iso) {
  const date=new Date(iso);
  const today=new Date(); today.setHours(0,0,0,0);
  const tasks=TASKS.map((t,i)=>({...t,i,date:getTaskDate(t,i),done:P().completedTasks.includes(i)})).filter(t=>isSameDay(t.date,date));
  if(!tasks.length){ document.getElementById('selectedDayTasks').classList.add('hidden'); return; }
  document.getElementById('selectedDayTasks').classList.remove('hidden');
  document.getElementById('selectedDayTitle').textContent=`Tareas del ${fmtFull(date)}`;
  let html='';
  tasks.forEach(t=>{
    const isOvr=!t.done&&t.date<today, hasMoved=P().taskDateOverrides[t.i]!==undefined;
    html+=`<div onclick="toggleTask(${t.i})" style="display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:10px;cursor:pointer;border:1px solid ${isOvr?'rgba(239,68,68,.2)':'var(--border)'};background:${isOvr?'rgba(239,68,68,.03)':'transparent'};margin-bottom:6px;transition:background .1s">
      <div class="check-box${t.done?' checked':''}">${t.done?'<svg width="10" height="10" viewBox="0 0 12 12" fill="none"><path d="M2 6l3 3 5-5" stroke="white" stroke-width="2" stroke-linecap="round"/></svg>':''}</div>
      <div style="flex:1;min-width:0">
        <div style="display:flex;align-items:center;gap:5px;flex-wrap:wrap;margin-bottom:4px">
          <span class="tag ${CAT_COLORS[t.category].cls}">${t.category}</span>
          ${t.critical?'<span class="tag cat-crit">CRÍTICO</span>':''}
          ${isOvr?'<span style="font-size:10px;color:#fca5a5">⚠ Atrasada</span>':''}
        </div>
        <span style="font-size:13px;${t.done?'text-decoration:line-through;color:var(--text3)':''}">${t.task}</span>
      </div>
      ${hasMoved?`<button onclick="event.stopPropagation();resetTaskDate(${t.i})" style="font-size:10px;color:var(--text3);background:none;border:none;cursor:pointer;padding:2px 6px;border-radius:5px;flex-shrink:0" title="Volver a fecha automática">↩</button>`:''}
    </div>`;
  });
  document.getElementById('selectedDayTasksList').innerHTML=html;
}

function resetTaskDate(i) { delete P().taskDateOverrides[i]; saveApp(); renderAll(); }

// ════════════════════════════════════════════════════
// TIMELINE
// ════════════════════════════════════════════════════
if (!window._phaseFilter) window._phaseFilter = 'all';

function renderTimeline() {
  const today=new Date(); today.setHours(0,0,0,0);
  const tasks=TASKS.map((t,i)=>({...t,i,date:getTaskDate(t,i),done:P().completedTasks.includes(i)}))
    .filter(t=>window._phaseFilter==='all'||t.phase===window._phaseFilter)
    .sort((a,b)=>a.date-b.date);

  document.getElementById('timelineCompleted').textContent=P().completedTasks.length;
  document.getElementById('tlTotal').textContent=TASKS.length;

  let html='<div class="tl-line"></div>';
  tasks.forEach((t,i)=>{
    const isOvr=!t.done&&t.date<today, isCur=isSameDay(t.date,today), hasMoved=P().taskDateOverrides[t.i]!==undefined;
    const dotCls='tl-dot'+(t.done?' done':isCur?' current':isOvr?' overdue':'');
    html+=`<div class="tl-item" style="animation-delay:${i*.04}s">
      <div class="tl-date">
        <span style="${isOvr?'color:#fca5a5':isCur?'color:#fcd34d;font-weight:700':''}">${fmtDate(t.date)}</span>
        <span class="tl-week">${t.week===0?'LAUNCH':(t.week>0?'+':'')+t.week+'sem'}</span>
        ${hasMoved?'<span class="tl-moved">📌 movida</span>':''}
      </div>
      <div class="${dotCls}"></div>
      <div onclick="toggleTask(${t.i})" class="tl-card${isOvr?' overdue':''}${t.done?' done-card':''}">
        <div class="tl-card-meta">
          <span class="tag ${CAT_COLORS[t.category].cls}">${t.category}</span>
          ${t.critical?'<span class="tag cat-crit">CRÍTICO</span>':''}
          ${t.done?'<span style="font-size:10px;color:#6ee7b7;margin-left:auto">✓ Completada</span>':''}
          ${isOvr?'<span style="font-size:10px;color:#fca5a5;margin-left:auto">⚠ Atrasada</span>':''}
          ${isCur&&!t.done?'<span style="font-size:10px;color:#fcd34d;margin-left:auto">📍 Hoy</span>':''}
        </div>
        <div class="tl-card-task${t.done?' done-text':''}">${t.task}</div>
      </div>
    </div>`;
  });
  document.getElementById('timelineContainer').innerHTML=html;
}

function filterPhase(phase, btn) {
  window._phaseFilter=phase;
  document.querySelectorAll('.phase-btn').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  renderTimeline();
}

// ════════════════════════════════════════════════════
// UPCOMING TASKS
// ════════════════════════════════════════════════════
function renderUpcoming() {
  const today=new Date(); today.setHours(0,0,0,0);
  const tasks=TASKS.map((t,i)=>({...t,i,date:getTaskDate(t,i),done:P().completedTasks.includes(i)}))
    .filter(t=>!t.done).sort((a,b)=>a.date-b.date).slice(0,6);
  if(!tasks.length){ document.getElementById('upcomingTasks').innerHTML='<p style="font-size:13px;color:var(--text3)">🎉 ¡Todas las tareas completadas!</p>'; return; }
  let html='';
  tasks.forEach(t=>{
    const isOvr=t.date<today, isToday=isSameDay(t.date,today);
    html+=`<div class="upcoming-item ${isOvr?'overdue':isToday?'today':'normal'}" onclick="toggleTask(${t.i})">
      <div class="check-box"></div>
      <div style="flex:1;min-width:0">
        <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin-bottom:3px">
          <span class="tag ${CAT_COLORS[t.category].cls}">${t.category}</span>
          <span style="font-size:10px;font-family:var(--mono);color:${isOvr?'#fca5a5':isToday?'#fcd34d':'var(--text3)'}">${fmtDate(t.date)}</span>
          ${isOvr?'<span style="font-size:10px;color:#fca5a5">⚠</span>':''}
          ${isToday?'<span style="font-size:10px;color:#fcd34d">📍 Hoy</span>':''}
        </div>
        <div style="font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${t.task}</div>
      </div>
    </div>`;
  });
  document.getElementById('upcomingTasks').innerHTML=html;
}

// ════════════════════════════════════════════════════
// TASK TOGGLE
// ════════════════════════════════════════════════════
function toggleTask(i) {
  const ct=P().completedTasks;
  ct.includes(i) ? P().completedTasks=ct.filter(x=>x!==i) : ct.push(i);
  saveApp(); renderAll();
}

// ════════════════════════════════════════════════════
// SPOTIFY
// ════════════════════════════════════════════════════
function connectSpotify() {
  const match=document.getElementById('spotifyLinkInput').value.match(/artist\/([a-zA-Z0-9]+)/);
  if(match) {
    P().spotify.artistId=match[1]; P().spotify.connected=true; saveApp();
    document.getElementById('spotifyEmbed').classList.remove('hidden');
    document.getElementById('embedContainer').innerHTML=`<iframe style="border-radius:10px" src="https://open.spotify.com/embed/artist/${match[1]}?utm_source=generator&theme=0" width="100%" height="260" frameBorder="0" allowfullscreen="" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="lazy"></iframe>`;
  }
}

function saveSpotifyStats() {
  const sp=P().spotify;
  sp.monthlyListeners=+document.getElementById('inputMonthlyListeners').value||0;
  sp.followers=+document.getElementById('inputFollowers').value||0;
  sp.streams28=+document.getElementById('inputStreams28').value||0;
  sp.streams7=+document.getElementById('inputStreams7').value||0;
  sp.saves=+document.getElementById('inputSaves').value||0;
  sp.playlistReach=+document.getElementById('inputPlaylistReach').value||0;
  sp.syncDate=document.getElementById('spotifySyncDate').value||new Date().toISOString().split('T')[0];
  sp.locked=true;
  saveApp(); renderSpotifyDisplay(); renderSpotifyWidget();
}

let _spotifyEditing=false;
function toggleSpotifyEdit() {
  _spotifyEditing=!_spotifyEditing;
  document.getElementById('spotifyEditBtn').textContent=_spotifyEditing?'✓ Guardar':'✏ Editar';
  if(_spotifyEditing) {
    document.getElementById('spotifyForm').classList.remove('hidden');
    document.getElementById('spotifyDisplay').classList.add('hidden');
    const sp=P().spotify;
    document.getElementById('inputMonthlyListeners').value=sp.monthlyListeners||'';
    document.getElementById('inputFollowers').value=sp.followers||'';
    document.getElementById('inputStreams28').value=sp.streams28||'';
    document.getElementById('inputStreams7').value=sp.streams7||'';
    document.getElementById('inputSaves').value=sp.saves||'';
