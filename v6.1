// HEADER
// ════════════════════════════════════════════════════
function renderHeader() {
  const p=P();
  document.getElementById('projectName').value=p.name;
  document.getElementById('releaseDate').value=p.releaseDate;
  const d=daysUntil(), cd=document.getElementById('countdown');
  cd.textContent=d===0?'🚀 LAUNCH DAY':`${Math.abs(d)}d ${d>0?'para launch':'post-launch'}`;
  cd.style.background=d<=0?'rgba(219,39,119,.12)':d<=7?'rgba(245,158,11,.12)':'rgba(124,58,237,.12)';
  cd.style.color=d<=0?'#f9a8d4':d<=7?'#fcd34d':'var(--violet2)';
}

