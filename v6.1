const QP = {
  contenido:`Basándote en el release "{name}" de género {genre} con un vibe {mood} dirigido a {audience}, dame 10 ideas de contenido específico para los 30 días previos al lanzamiento. Incluye formato, plataforma ({platforms}) y mejor momento.`,
  hooks:`Crea 8 hooks creativos para TikTok y Reels para "{name}" ({genre}, {mood}). Capturen atención en 3 segundos. Público: {audience}.`,
  bio:`Escribe 3 versiones de bio de artista (150, 300 y 500 chars) para un artista de {genre} con el release "{name}" de sonido {mood}.`,
  pitch:`Escribe un email de pitch profesional para curadores de playlist de {genre} para "{name}". Incluye subject, cuerpo y CTA. El artista tiene {listeners} monthly listeners.`,
  caption:`Escribe 6 captions para Instagram/TikTok para el lanzamiento de "{name}" ({genre}). Uno para el día, tres para la semana, dos post-lanzamiento. Incluye hashtags.`,
  ads:`Copy para anuncios Facebook/Instagram/TikTok Ads para "{name}" ({genre}): headline (6 palabras), descripción (30 palabras), CTA. Para 3 audiencias distintas.`,
  research:`Análisis de mercado para un artista de {genre} con vibe {mood} dirigido a {audience}. Incluye playlists relevantes en Spotify, curadores, artistas similares y estrategias de crecimiento orgánico.`,
  estrategia:`Estrategia de lanzamiento completa de 8 semanas para "{name}" ({genre}). Semana a semana, presupuesto por canal, KPIs a trackear, momentum post-lanzamiento. Plataformas: {platforms}.`
};

function quickPrompt(type) {
  const p=P(), s=p.ai;
  const msg=QP[type]
    .replace('{name}',p.name)
    .replace('{genre}',s.genre||'Latin/Indie')
    .replace('{mood}',s.mood||'melódico y nostálgico')
    .replace('{audience}',s.audience||'18-28 años')
    .replace('{platforms}',s.platforms||'Instagram, TikTok, Spotify')
    .replace('{listeners}',fmt(p.spotify.monthlyListeners));
  document.getElementById('chatInput').value=msg;
  sendChat();
}

async function sendChat() {
  const input=document.getElementById('chatInput');
  const msg=input.value.trim(); if(!msg) return;
  input.value='';

  // save AI context
  const ai=P().ai;
  ai.genre=document.getElementById('aiGenre').value;
  ai.mood=document.getElementById('aiMood').value;
  ai.audience=document.getElementById('aiAudience').value;
  ai.platforms=document.getElementById('aiPlatforms').value;
  saveApp();

  addChat('user',msg);
  if(!app.globalAI.apiKey){ addChat('assistant','⚠ Conecta tu API key de Anthropic arriba para usar el asistente.'); return; }

  const lid='l'+Date.now(); addChat('assistant','⋯ Generando ideas...', lid, true);

  const sys=`Eres un experto en marketing musical, A&R y estrategia de lanzamiento para artistas independientes.
Release: "${P().name}" | Género: ${ai.genre||'N/E'} | Mood: ${ai.mood||'N/E'}
Audiencia: ${ai.audience||'N/E'} | Plataformas: ${ai.platforms||'N/E'}
Monthly Listeners: ${fmt(P().spotify.monthlyListeners)||'N/E'} | Release Date: ${P().releaseDate}
Responde en español, práctico, específico y accionable. Sin generalidades.`;

  const msgs=[...((P().ai.chatHistory)||[]),{role:'user',content:msg}];

  try {
    const res=await fetch('https://api.anthropic.com/v1/messages',{
      method:'POST',
      headers:{'Content-Type':'application/json','x-api-key':app.globalAI.apiKey,'anthropic-version':'2023-06-01','anthropic-dangerous-direct-browser-access':'true'},
      body:JSON.stringify({model:'claude-opus-4-5',max_tokens:1500,system:sys,messages:msgs.slice(-10)})
    });
    const data=await res.json();
    const reply=data.content?.[0]?.text||'Error al obtener respuesta.';
    document.getElementById(lid)?.remove();
    addChat('assistant',reply);
    P().ai.chatHistory=[...msgs,{role:'assistant',content:reply}].slice(-20);
    saveApp();
  } catch(e) {
    document.getElementById(lid)?.remove();
    addChat('assistant',`❌ Error: ${e.message}`);
  }
}

function addChat(role, text, id, loading) {
  const c=document.getElementById('chatMessages');
  const d=document.createElement('div');
  d.className=`chat-msg ${role} fade-up${loading?' loading':''}`;
  if(id) d.id=id;
  d.innerHTML=`<div class="chat-msg-label">${role==='user'?'Tú':'Asistente'}</div><div class="chat-body">${text}</div>`;
  c.appendChild(d); c.scrollTop=c.scrollHeight;
}

// ════════════════════════════════════════════════════
// COMMAND STATS (lightweight re-render)
// ════════════════════════════════════════════════════
function renderCommandStats() {
  const p=P();
  const taskProg=(p.completedTasks.length/TASKS.length)*100;
  const splitsTotal=p.splits.reduce((s,x)=>s+x.percentage,0);
  const readiness=(taskProg+(splitsTotal===100?100:0))/2;

  // Ring
  const r=24, c=r*2*Math.PI, o=c-(readiness/100)*c;
  document.getElementById('readinessRing').innerHTML=
    `<circle stroke="var(--border)" fill="none" stroke-width="5" r="${r}" cx="30" cy="30" style="transform:rotate(-90deg);transform-origin:center"/>
    <circle stroke="var(--violet)" fill="none" stroke-width="5" stroke-linecap="round" r="${r}" cx="30" cy="30" stroke-dasharray="${c} ${c}" stroke-dashoffset="${o}" style="transform:rotate(-90deg);transform-origin:center;transition:stroke-dashoffset .5s"/>
    <text x="30" y="35" text-anchor="middle" fill="var(--text)" font-size="12" font-weight="800" font-family="JetBrains Mono">${readiness.toFixed(0)}%</text>`;
  document.getElementById('readinessLabel').textContent=readiness>=80?'Ready':readiness>=50?'Progress':'Setup';
  document.getElementById('tasksCompleted').textContent=p.completedTasks.length;
  document.getElementById('totalTasksCount').textContent=TASKS.length;
  document.getElementById('tasksProgress').style.width=`${taskProg}%`;
  document.getElementById('splitsTotal').textContent=`${splitsTotal}%`;
  document.getElementById('splitsTotal').style.color=splitsTotal===100?'var(--emerald)':'var(--rose)';

  const today=new Date(); today.setHours(0,0,0,0);
  const oc=TASKS.filter((t,i)=>!p.completedTasks.includes(i)&&getTaskDate(t,i)<today).length;
  const oa=document.getElementById('overdueAlert');
  oa.style.display=oc?'flex':'none';
  if(oc) document.getElementById('overdueCount').textContent=oc;

  const spent=p.budget.items.reduce((s,i)=>s+i.spent,0);
  document.getElementById('budgetSpent').textContent=spent;
  document.getElementById('budgetTotalHeader').textContent=p.budget.total;
}

