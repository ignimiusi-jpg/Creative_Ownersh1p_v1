function renderSplits() {
  const total=P().splits.reduce((s,x)=>s+x.percentage,0);
  const badge=document.getElementById('splitsTotalBadge');
  badge.textContent=`${total}%`;
  badge.style.background=total===100?'rgba(16,185,129,.15)':'rgba(239,68,68,.12)';
  badge.style.color=total===100?'#6ee7b7':'#fca5a5';
  badge.style.border=`1px solid ${total===100?'rgba(16,185,129,.25)':'rgba(239,68,68,.25)'}`;

  // Bar
  let barH='', legH='';
  P().splits.forEach((s,i)=>{ const c=SPLIT_PALETTE[i%SPLIT_PALETTE.length],pct=Math.max(0,s.percentage);
    barH+=`<div class="split-bar-seg" style="width:${pct}%;background:${c}" title="${s.name}: ${s.percentage}%"></div>`;
    legH+=`<div style="display:flex;align-items:center;gap:5px"><div style="width:10px;height:10px;border-radius:3px;background:${c}"></div><span style="font-size:11px;color:var(--text3)">${s.name} <strong style="font-family:var(--mono)">${s.percentage}%</strong></span></div>`;
  });
  if(total<100) barH+=`<div class="split-bar-seg" style="width:${100-total}%;background:var(--border)"></div>`;
  document.getElementById('splitBar').innerHTML=barH;
  document.getElementById('splitLegend').innerHTML=legH;

  // List
  let html='';
  P().splits.forEach((s,i)=>{ const c=SPLIT_PALETTE[i%SPLIT_PALETTE.length];
    html+=`<div class="split-item">
      <div class="split-color-bar" style="background:${c}"></div>
      <div class="split-inputs">
        <input class="split-input-name" type="text" value="${s.name}" onchange="updateSplit(${i},'name',this.value)">
        <input class="split-input-role" type="text" value="${s.role}" onchange="updateSplit(${i},'role',this.value)">
      </div>
      <select class="select-sm" onchange="updateSplit(${i},'type',this.value)">
        <option value="both"${s.type==='both'?' selected':''}>Master+Pub</option>
        <option value="master"${s.type==='master'?' selected':''}>Solo Master</option>
        <option value="publishing"${s.type==='publishing'?' selected':''}>Solo Pub</option>
      </select>
      <div style="display:flex;align-items:center;gap:4px">
        <input class="split-pct" type="number" min="0" max="100" value="${s.percentage}" onchange="updateSplit(${i},'percentage',+this.value)">
        <span style="color:var(--text3);font-size:13px">%</span>
      </div>
      ${P().splits.length>1?`<button onclick="removeSplit(${i})" style="background:none;border:none;color:var(--text3);cursor:pointer;font-size:14px;padding:2px 6px;border-radius:5px" onmouseover="this.style.color='#fca5a5'" onmouseout="this.style.color='var(--text3)'">✕</button>`:''}
    </div>`;
  });
  document.getElementById('splitsList').innerHTML=html;

  document.getElementById('splitsTotal').textContent=`${total}%`;
  document.getElementById('splitsTotal').style.color=total===100?'var(--emerald)':'var(--rose)';
}

